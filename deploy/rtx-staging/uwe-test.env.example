# UWE Staging (RTX-PC) — nach C:\uwe-test\.env kopieren und Werte anpassen.
# Getrennte Test-Umgebung, on-demand. Siehe docs/engineering/staging-rtx.md.
# NIEMALS die Prod-Secrets hier eintragen.

NODE_ENV=production
UWE_RUNTIME_ROLE=host

# --- Ports (getrennt von Prod 3000/3001) ---
STUDIO_PORT=3002
PORTAL_PORT=3003

# --- Oeffentliche URLs — NEXT_PUBLIC_* werden beim BUILD eingebacken! ---
NEXT_PUBLIC_STUDIO_URL=https://test.studio.uwe.example
NEXT_PUBLIC_PORTAL_URL=https://test.portal.uwe.example
PUBLIC_BASE_URL=https://test.studio.uwe.example
TRUST_PROXY=true
CLOUDFLARE_TUNNEL=true

# --- Secrets — EIGENE Werte, niemals die Prod-Werte (openssl rand -base64 32) ---
# Im Produktions-Build Pflicht; fehlen sie, bricht der Start ab.
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_32

# --- Datenbank + Daten (Test) — absolute Pfade, Vorwaerts-Slashes fuer Prisma ---
DATABASE_URL=file:C:/uwe-test/data/uwe-test.db
UWE_DATA_DIR=C:/uwe-test/data
UPLOADS_DIR=C:/uwe-test/data/uploads
BACKUPS_DIR=C:/uwe-test/data/backups
EXPORTS_DIR=C:/uwe-test/data/exports

# --- Seed-Verhalten ---
RUN_DB_SEED=auto

# --- Auth / Cookies (hinter HTTPS-Tunnel) ---
AUTH_REQUIRED=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# --- AI: lokales Ollama auf dem RTX-PC nutzen, Cloud aus ---
AI_INFERENCE_ENABLED=true
AI_INFERENCE_PROVIDER=ollama
AI_INFERENCE_BASE_URL=http://localhost:11434
CLOUD_AI_PROVIDER=
