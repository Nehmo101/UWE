[Unit]
Description=Trigger the UWE Morning Briefing
Documentation=file:///opt/uwe/docs/deployment-hardening.md
Requires=uwe.service
After=uwe.service

[Service]
Type=oneshot
User=uwe
Group=uwe
Environment=UWE_HOME=/opt/uwe
Environment=UWE_ENV=/etc/uwe/uwe.env
EnvironmentFile=-/etc/uwe/uwe.env
ExecStart=/opt/uwe/deploy/scripts/uwe-briefing.sh
