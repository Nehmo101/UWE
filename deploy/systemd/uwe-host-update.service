[Unit]
Description=UWE host update (git pull + setup-uwe-host.sh --quick)
Documentation=file:///opt/uwe/docs/UWE_HOST_LINUX_STARTUP.md
After=network-online.target
Wants=network-online.target
Conflicts=uwe-host-update.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/uwe
Environment=UWE_HOME=/opt/uwe
Environment=UWE_ENV=/etc/uwe/uwe.env
EnvironmentFile=-/etc/uwe/uwe.env
ExecStart=/opt/uwe/deploy/scripts/uwe-host-update.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=uwe-host-update

[Install]
WantedBy=multi-user.target
