# Cloudflare API credentials for deploy/scripts/configure-cloudflare-tunnel.sh
# Copy to /etc/uwe/cloudflare.env (chmod 600, root:uwe) — never commit real tokens.
#
# Required API token permissions:
#   - Account → Cloudflare One Connectors → Edit (or Cloudflare Tunnel → Edit)
#   - Zone → DNS → Edit (zone: uweanddragons.org)
#
# CLOUDFLARE_API_TOKEN=your_token_here
# CLOUDFLARE_ACCOUNT_ID=2900c1e1ac39ce228f3b0a88bd83558f
# CLOUDFLARE_TUNNEL_ID=7760201a-52f9-4a48-aae8-eeea2845c65a
#
# Only Studio (:3000) and Portal (:3001) belong in the tunnel ingress. The
# owner-only Brain surface (:3002) is local/LAN only per ADR 004/007 and must
# NEVER be added here — configure-cloudflare-tunnel.sh only ever writes the
# Studio/Portal ingress, and check-cloudflare-tunnel.sh fails if Brain leaks in.
