# Cloudflare Tunnel - UWE Subdomain deployment (recommended)
# Portal: https://uweanddragons.org -> local Portal app (:3001)
# Studio: https://studio.uweanddragons.org -> local Studio app (:3000)
#
# This setup avoids /studio path rewriting and does not require a local Caddy/nginx
# reverse proxy just to split Studio and Portal traffic.
#
# Docs: docs/cloudflare-access.md

tunnel: uwe-host
credentials-file: /etc/cloudflared/uwe-host.json

ingress:
  - hostname: uweanddragons.org
    service: http://127.0.0.1:3001
  - hostname: studio.uweanddragons.org
    service: http://127.0.0.1:3000
  - service: http_status:404