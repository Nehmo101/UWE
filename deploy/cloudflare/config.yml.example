# Cloudflare Tunnel — Unified Path (uweandragons.org)
# Copy to /etc/cloudflared/config.yml and adjust tunnel name + credentials path.
# Requires a local reverse proxy on :8080 — see Caddyfile.example in this folder.
#
# Docs: docs/cloudflare-access.md

tunnel: uwe-laptop
credentials-file: /etc/cloudflared/uwe-laptop.json

ingress:
  - hostname: uweandragons.org
    service: http://127.0.0.1:8080
  - service: http_status:404
