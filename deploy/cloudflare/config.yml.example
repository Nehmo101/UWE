# Cloudflare Tunnel - UWE split-hostname deployment (recommended)
# Landing: https://uweanddragons.org        -> Studio app (:3000) — public entry + sign-in
# Studio:  https://studio.uweanddragons.org  -> Studio app (:3000)
# Portal:  https://portal.uweanddragons.org  -> Portal app (:3001)
# Brain:   https://brain.uweanddragons.org  -> Brain app  (:3002) — owner-only, opt-in (see below)
#
# One sign-in on the apex landing is valid on both subdomains when
# SESSION_COOKIE_DOMAIN=.uweanddragons.org is set (see .env.production.example).
#
# Remotely-managed tunnels: apply via Cloudflare Zero Trust dashboard or
#   CLOUDFLARE_API_TOKEN=... bash deploy/scripts/configure-cloudflare-tunnel.sh
#
# Docs: docs/cloudflare-access.md, docs/cloudflare-current-setup.md

tunnel: uwe-host
credentials-file: /etc/cloudflared/uwe-host.json

ingress:
  - hostname: studio.uweanddragons.org
    service: http://127.0.0.1:3000
  - hostname: portal.uweanddragons.org
    service: http://127.0.0.1:3001
  # Legacy /studio and /portal path bookmarks on the apex — keep these BEFORE the
  # apex catch-all below so they still route to their app.
  - hostname: uweanddragons.org
    path: /studio
    service: http://127.0.0.1:3000
  - hostname: uweanddragons.org
    path: /portal
    service: http://127.0.0.1:3001
  # Apex root = the public landing page, served by the Studio app. Its
  # /api/auth/enter signs the visitor in (Studio, Portal or Brain target) and,
  # with a domain-wide session cookie, the redirect to studio./portal./brain.
  # stays logged in.
  - hostname: uweanddragons.org
    service: http://127.0.0.1:3000
  # Brain (Daily Admin OS + Personal Brain, :3002) holds the most sensitive data
  # in the installation. Publishing it is a deliberate opt-in, never a default:
  # every route enforces the `owner` role server-side, and
  # deploy/scripts/check-cloudflare-tunnel.sh fails on a Brain ingress unless
  # BRAIN_PUBLIC_TUNNEL=1 is set. Enable 2FA on the owner account first.
  # Uncomment only when you mean it:
  #   - hostname: brain.uweanddragons.org
  #     service: http://127.0.0.1:3002
  - service: http_status:404
