# Legacy unified-path reverse proxy example.
#
# The recommended Cloudflare deployment now uses split hostnames and does not
# need Caddy/nginx path rewriting:
#   uweanddragons.org        -> Portal :3001
#   studio.uweanddragons.org -> Studio :3000
#
# Keep this file only for installations that deliberately stay on one hostname
# with /studio/* path routing. New installs should use config.yml.example.

:8080 {
	# Portal API and UI
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	# Studio API - /studio/api/* -> Studio /api/*
	handle /studio/api/* {
		uri strip_prefix /studio
		reverse_proxy 127.0.0.1:3000
	}

	# Studio UI - /studio/* -> Studio /*
	handle /studio/* {
		uri strip_prefix /studio
		reverse_proxy 127.0.0.1:3000
	}

	# Admin / setup on Studio for legacy links
	handle /admin/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /setup* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		reverse_proxy 127.0.0.1:3001
	}
}