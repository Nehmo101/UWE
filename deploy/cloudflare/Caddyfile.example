# Local reverse proxy for Unified Path deployment.
# Routes Portal + Studio behind cloudflared, which forwards to 127.0.0.1:8080
# (see config.yml.example). Listens on plain HTTP :8080 — TLS is terminated at
# the Cloudflare edge, so this block must NOT use a hostname site address (that
# would make Caddy provision certs and bind :443 instead of :8080).
# Copy to /etc/caddy/Caddyfile (or include from your Caddy config).
#
# Docs: docs/cloudflare-access.md

:8080 {
	# Portal API — public (no Cloudflare Access on /api/*)
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	# Studio API — /studio/api/* → Studio /api/*
	handle /studio/api/* {
		uri strip_prefix /studio
		reverse_proxy 127.0.0.1:3000
	}

	# Studio UI — /studio/*
	handle /studio/* {
		uri strip_prefix /studio
		reverse_proxy 127.0.0.1:3000
	}

	# Admin / Setup (Cloudflare Access on these paths)
	handle /admin/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /setup* {
		reverse_proxy 127.0.0.1:3000
	}

	# Portal UI — default
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}
