# UWE — Universeller Welten-Editor
# Copy to .env and adjust values for local development or Docker.
# See docs/PRODUCTION.md for production deployment guidance.

# --- Release / Production ---
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET=generate-a-random-secret-for-production

# Demo seed on first Docker start (empty database):
#   auto  — seed demo world when the database is empty (recommended for first try)
#   true  — always seed once (until .seeded marker exists)
#   false — never seed (use in production)
RUN_DB_SEED=auto

# Optional: protect sensitive Studio API routes (backup, restore, import,
# settings, AI, export, uploads) from non-browser clients.
# When set, scripts/tools must send "Authorization: Bearer <token>".
# The Studio UI itself keeps working without it (same-origin requests).
# STUDIO_API_TOKEN=

# Studio (DM app) — default http://localhost:3000
STUDIO_PORT=3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000

# Portal (player app) — default http://localhost:3001
PORTAL_PORT=3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# Database (SQLite — path relative to packages/database in dev, /data/uwe.db in Docker)
DATABASE_URL=file:./data/uwe.db

# Persistent folders (Docker bind mounts use ./data/*)
UPLOADS_DIR=./data/uploads
EXPORTS_DIR=./exports
BACKUPS_DIR=./data/backups

# AI Brain (optional — local-first, Studio only)
AI_BRAIN_ENABLED=true
AI_DATENSCHUTZ_MODE=false
AI_LOCAL_ONLY=false
AI_DEFAULT_PROVIDER=ollama
AI_USE_MOCK=false
NEXT_PUBLIC_AI_USE_MOCK=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1

# Label image generation (optional — provider interface prepared, default: disabled)
# LABEL_IMAGE_PROVIDER=disabled
