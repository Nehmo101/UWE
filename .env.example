# UWE — Universeller Welten-Editor
# Copy to .env and adjust values for local development.

# Studio (DM app) — default http://localhost:3000
STUDIO_PORT=3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000

# Portal (player app) — default http://localhost:3001
PORTAL_PORT=3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# Core API (future) — default http://localhost:4000
CORE_API_PORT=4000
CORE_API_URL=http://localhost:4000

# Database (SQLite for local dev — path relative to packages/database)
DATABASE_URL=file:./data/uwe.db

# Auth (session cookies — set a strong secret in production)
AUTH_SECRET=generate-a-random-secret-for-production

# AI Brain (optional — local-first)
AI_BRAIN_ENABLED=true
AI_DATENSCHUTZ_MODE=false
AI_LOCAL_ONLY=false
AI_DEFAULT_PROVIDER=ollama
AI_USE_MOCK=false
NEXT_PUBLIC_AI_USE_MOCK=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1
