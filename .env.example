# UWE — Universeller Welten-Editor
# Copy to .env and adjust values for local development or the Linux host.
# See docs/secrets.md and docs/host-linux.md for production deployment.

# --- Release / Production ---
# NODE_ENV=production

# Generate strong secrets: openssl rand -base64 32
# SESSION_SECRET encrypts OAuth tokens and other server-side secrets.
# Legacy alias: AUTH_SECRET (either name works; SESSION_SECRET is preferred).
SESSION_SECRET=generate-a-random-secret-for-production

# Protects setup/repair/bootstrap operations — required in production.
# UWE_SETUP_TOKEN=

# Public HTTPS URL when behind reverse proxy or Cloudflare Tunnel.
# Legacy alias: PUBLIC_APP_URL
# PUBLIC_BASE_URL=https://uwe.example.org

# --- Runtime role ---
# host           — always-on instance (website, studio, portal, db, queue). Default.
# rtx-connector  — optional outbound worker (configure separately in
#                  tools/uwe-rtx-connector/.env — never required for UWE online).
UWE_RUNTIME_ROLE=host

# --- RTX Host Connector (host side) ---
# Connectors are optional outbound workers; UWE is fully online without them.
# Pause the queue host-wide (connectors stop receiving jobs):
# UWE_HOST_QUEUE_DISABLED=false
# Allow cloud AI fallback when local LLMs are unavailable:
# UWE_AI_CLOUD_FALLBACK=false
# Optional loop-timing hints sent to connectors:
# UWE_HOST_CONNECTOR_POLL_MS=2000
# UWE_HOST_CONNECTOR_HEARTBEAT_MS=15000

# Demo seed on first host start (empty database):
#   auto  — seed demo world when the database is empty (recommended for first try)
#   true  — always seed once (until .seeded marker exists)
#   false — never seed (use in production)
RUN_DB_SEED=auto

# Optional: protect sensitive Studio API routes (backup, restore, import,
# settings, AI, export, uploads) from non-browser clients.
# STUDIO_API_TOKEN=

# Optional: stricter token for backup restore execute via API/scripts.
# When set, remote restore clients must use this token (not STUDIO_API_TOKEN).
# Same-origin Studio UI restore keeps working on trusted networks.
# RESTORE_OWNER_TOKEN=

# Optional upload size cap in bytes (default 52428800 = 50 MB)
# UPLOAD_MAX_BYTES=52428800

# Optional preferred DnD world for /today dashboard (must match an existing world slug)
# PREFERRED_WORLD_SLUG=terra

# Studio (DM app) — default http://localhost:3000
STUDIO_PORT=3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000
# Design V2 UI refresh (default on; set false to revert to legacy shells)
# NEXT_PUBLIC_UWE_DESIGN_V2=false

# Portal (player app) — default http://localhost:3001
PORTAL_PORT=3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# --- Public URL / Cloudflare / Proxy (production) ---
# Path-based unified layout (optional — defaults /studio and /portal under PUBLIC_BASE_URL):
# STUDIO_PATH=/studio
# PORTAL_PATH=/portal
# Client-side Studio API resolution (browser fetch):
# NEXT_PUBLIC_STUDIO_PATH=/studio
# NEXT_PUBLIC_STUDIO_API_ORIGIN=https://uwe.example.org/studio
# TRUST_PROXY=true
# CLOUDFLARE_TUNNEL=true
# CLOUDFLARE_ACCESS_ENABLED=true
# Comma-separated allowlist for CF-Access-Authenticated-User-Email header (optional):
# STUDIO_ACCESS_ALLOWED_EMAILS=owner@example.org

# --- "Ich bin ein Mensch" check (Cloudflare Turnstile) ---
# Shows a Cloudflare "Verify you are human" widget on the Studio + Portal login
# forms and verifies the token server-side before sign-in. Opt-in: leave both
# keys empty to disable. Create keys at Cloudflare → Turnstile.
# Cloudflare test keys (always pass — dev/QA only, never production):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Optional kill-switch — set false to disable even when keys are present:
# TURNSTILE_ENABLED=true

# --- Auth / Session cookies (production behind HTTPS) ---
AUTH_REQUIRED=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
# Optional fallback when settings.auth.sessionInactivityTimeoutMinutes is 0 (minutes; 0 = off)
# SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# Optional shared rate-limit directory for multi-instance deployments (file-backed store).
# UWE_RATE_LIMIT_DIR=./data/rate-limits
# Optional Redis URL for distributed rate limiting across instances.
# UWE_REDIS_URL=redis://127.0.0.1:6379

# Optional comma-separated list of trusted browser origins for API requests.
# Default: same-origin only (no wildcard). Use only when a trusted companion app
# must call UWE APIs from the browser.
# ALLOWED_CORS_ORIGINS=https://partner.example

# --- Player Preview security ---
PLAYER_PREVIEW_PUBLIC=false
PLAYER_PREVIEW_REQUIRE_TOKEN=true
# PLAYER_PREVIEW_ALLOW_DM_ONLY=false

# Database (SQLite — path relative to packages/database in dev, absolute on the host)
DATABASE_URL=file:./data/uwe.db

# Maximum upload size for Studio assets (megabytes)
MAX_UPLOAD_MB=50

# --- Persistent data paths (production host) ---
# UWE_DATA_DIR=/var/lib/uwe
# UWE_UPLOADS_DIR=/var/lib/uwe/uploads
# UWE_BACKUP_DIR=/var/lib/uwe/backups
# UWE_EXPORT_DIR=/var/lib/uwe/exports

# Legacy aliases — still supported:
UPLOADS_DIR=./data/uploads
EXPORTS_DIR=./exports
BACKUPS_DIR=./data/backups

# --- Upload security ---
# Max single-file upload size in bytes (default: 25 MB)
# UWE_UPLOAD_MAX_BYTES=26214400
# Allow document uploads (pdf, md, txt) — default true
# UWE_UPLOAD_ALLOW_DOCUMENTS=true
# Allow GIF uploads — default true
# UWE_UPLOAD_ALLOW_GIF=true
# Strip EXIF metadata from uploaded images — default true
# UWE_UPLOAD_STRIP_EXIF=true
# Generate WebP thumbnails for uploaded images — default true
# UWE_UPLOAD_GENERATE_THUMBNAILS=true
# ZIP import / backup restore limits:
# UWE_ZIP_IMPORT_MAX_BYTES=104857600
# UWE_ZIP_IMPORT_MAX_UNCOMPRESSED_BYTES=209715200
# UWE_ZIP_IMPORT_MAX_FILES=500

# AI Brain (optional — local-first, Studio only)
AI_BRAIN_ENABLED=true
AI_DATENSCHUTZ_MODE=false
AI_LOCAL_ONLY=false
AI_DEFAULT_PROVIDER=ollama
AI_USE_MOCK=false
NEXT_PUBLIC_AI_USE_MOCK=false
BRAIN_ENABLED=true
BRAIN_STORAGE=database
BRAIN_DEFAULT_VISIBILITY=dm_only
BRAIN_ALLOW_DM_ONLY_CONTEXT=true
BRAIN_MAX_CONTEXT_CHARS=24000
BRAIN_REQUIRE_REVIEW_BEFORE_APPLY=true

# RTX Inference (Heimnetz — Ollama / LM Studio auf RTX-PC, direkter Endpoint)
# AI_INFERENCE_ENABLED=true
# AI_INFERENCE_PROVIDER=ollama
# AI_INFERENCE_BASE_URL=http://192.168.x.x:11434
# AI_INFERENCE_DEFAULT_MODEL=qwen2.5-coder:7b
# AI_INFERENCE_TIMEOUT_SECONDS=120
# AI_INFERENCE_ALLOW_PUBLIC_URL=false
# AI_INFERENCE_API_KEY=

# RTX Worker URL/token (optional image-worker/security-boundary path).
# Prefer the outbound RTX Host Connector for queue work; these values are only
# needed when a direct LAN worker endpoint is intentionally configured.
# RTX_BASE_URL=http://192.168.x.x:8765
# RTX_SERVICE_TOKEN=
RTX_HEALTHCHECK_INTERVAL_MS=10000
RTX_TIMEOUT_MS=3000
RTX_MAX_RETRIES=2
# Optional HMAC zwischen UWE und RTX-Worker (zusätzlich zum Bearer-Token)
# RTX_HMAC_SECRET=
PREFERRED_LOCAL_MODEL=

# AI Security Policy (Studio — Rate Limits, Prompt/Context/Model Guards)
# AI_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_MAX_PROMPT_LENGTH=32000
# AI_MAX_CONTEXT_CHARS=24000
# AI_MAX_OUTPUT_TOKENS=8192
# AI_ALLOWED_MODELS=llama3.2,qwen2.5-coder:7b
# AI_LOG_PROMPTS=false
# AI_LOG_PROMPT_MAX_CHARS=240
# AI_FETCH_ALLOWLIST=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,openrouter.ai

# Cloud-KI (nur Allgemeiner Chat — kein Brain, kein Objekt, keine Weltdaten)
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=

# Legacy Cloud-Provider-Keys (alternativ zu CLOUD_AI_*)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Brain Embeddings (RTX computes vectors, UWE stores them permanently)
BRAIN_EMBEDDINGS_ENABLED=true
BRAIN_EMBEDDING_PROVIDER=ollama
BRAIN_EMBEDDING_MODEL=nomic-embed-text
BRAIN_EMBEDDINGS_STORE=uwe-database

# Spotify Soundboard (optional)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Mail Center (optional — outbound SMTP)
# MAIL_ENABLED=true
# MAIL_FROM="UWE <noreply@example.org>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_LOG_BODY=false

# Image Studio (optional)
# IMAGE_STUDIO_ENABLED=true
# DIFFUSION_API_URL=http://127.0.0.1:7860
# OLLAMA_IMAGE_MODEL=flux

# Deep Research (optional)
# SEARXNG_URL=http://127.0.0.1:8080

# Calendar Integration (optional)
# CALENDAR_ENABLED=true
# CALDAV_PASSWORD=

# Cursor Agent Jobs (optional)
# AGENT_JOBS_GITHUB_TOKEN=
# CURSOR_CLOUD_API_KEY=
