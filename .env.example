# UWE — Universeller Welten-Editor
# Copy to .env and adjust values for local development or Docker.
# See docs/PRODUCTION.md for production deployment guidance.

# --- Release / Production ---
# Set in production on the old laptop / self-hosted host:
# NODE_ENV=production

# Generate a strong secret: openssl rand -base64 32
# Used to encrypt Spotify OAuth tokens per world — keep stable after connecting accounts.
AUTH_SECRET=generate-a-random-secret-for-production

# Demo seed on first Docker start (empty database):
#   auto  — seed demo world when the database is empty (recommended for first try)
#   true  — always seed once (until .seeded marker exists)
#   false — never seed (use in production)
RUN_DB_SEED=auto

# Optional: protect sensitive Studio API routes (backup, restore, import,
# settings, AI, export, uploads) from non-browser clients.
# When set, scripts/tools must send "Authorization: Bearer <token>".
# The Studio UI itself keeps working without it (same-origin requests).
# STUDIO_API_TOKEN=

# Optional preferred DnD world for /today dashboard (must match an existing world slug)
# PREFERRED_WORLD_SLUG=terra

# Studio (DM app) — default http://localhost:3000
STUDIO_PORT=3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000

# Portal (player app) — default http://localhost:3001
PORTAL_PORT=3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# --- Public URL / Cloudflare / Proxy (production) ---
# Set when UWE is reachable via Cloudflare Tunnel or reverse proxy:
# PUBLIC_APP_URL=https://uweandragons.org
# TRUST_PROXY=true
# CLOUDFLARE_TUNNEL=true

# --- Auth / Session cookies (production behind HTTPS) ---
# AUTH_REQUIRED=true
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax

# --- Player Preview security ---
# PLAYER_PREVIEW_PUBLIC=false
# PLAYER_PREVIEW_REQUIRE_TOKEN=true
# PLAYER_PREVIEW_ALLOW_DM_ONLY=false

# Database (SQLite — path relative to packages/database in dev, /data/uwe.db in Docker)
DATABASE_URL=file:./data/uwe.db

# --- Persistent data paths (production host) ---
# Optional base directory. When set, uploads/backups default under this path
# unless overridden individually.
# Linux example: UWE_DATA_DIR=/var/lib/uwe
# Windows example: UWE_DATA_DIR=C:\UWE\data

# Preferred production paths (override UWE_DATA_DIR defaults):
# UWE_UPLOADS_DIR=/var/lib/uwe/uploads
# UWE_BACKUP_DIR=/var/lib/uwe/backups
# UWE_EXPORT_DIR=/var/lib/uwe/exports

# Legacy aliases — still supported (Docker Compose uses these):
UPLOADS_DIR=./data/uploads
EXPORTS_DIR=./exports
BACKUPS_DIR=./data/backups

# AI Brain (optional — local-first, Studio only)
AI_BRAIN_ENABLED=true
AI_DATENSCHUTZ_MODE=false
AI_LOCAL_ONLY=false
AI_DEFAULT_PROVIDER=ollama
AI_USE_MOCK=false
NEXT_PUBLIC_AI_USE_MOCK=false
# Brain Knowledge Store (stored in UWE database on host laptop)
BRAIN_ENABLED=true
BRAIN_STORAGE=database
BRAIN_DEFAULT_VISIBILITY=dm_only
BRAIN_ALLOW_DM_ONLY_CONTEXT=true
BRAIN_MAX_CONTEXT_CHARS=24000
BRAIN_REQUIRE_REVIEW_BEFORE_APPLY=true

# RTX Inference (Heimnetz — Ollama / LM Studio auf RTX-PC, direkter Endpoint)
# AI_INFERENCE_ENABLED=true
# AI_INFERENCE_PROVIDER=ollama
# AI_INFERENCE_BASE_URL=http://192.168.178.50:11434
# AI_INFERENCE_DEFAULT_MODEL=qwen2.5-coder:7b
# AI_INFERENCE_TIMEOUT_SECONDS=120
# AI_INFERENCE_ALLOW_PUBLIC_URL=false
# AI_INFERENCE_API_KEY=
# LM Studio / OpenAI-compatible example:
# AI_INFERENCE_PROVIDER=openai-compatible
# AI_INFERENCE_BASE_URL=http://192.168.178.50:1234/v1
# AI_INFERENCE_DEFAULT_MODEL=local-model

# UWE RTX-Agent (empfohlen — Proxy auf dem RTX-PC, Token-geschützt)
# UWE spricht nur mit dem Agent; der Agent leitet an Ollama/LM Studio weiter.
RTX_AGENT_URL=
RTX_AGENT_TOKEN=
RTX_HEALTHCHECK_INTERVAL_MS=10000
RTX_TIMEOUT_MS=3000
PREFERRED_LOCAL_MODEL=

# Cloud-KI (nur Allgemeiner Chat — kein Brain, kein Objekt, keine Weltdaten)
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=

# Legacy Cloud-Provider-Keys (alternativ zu CLOUD_AI_*)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Legacy per-provider URLs (AI_INFERENCE_BASE_URL takes precedence)
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1

# Brain Knowledge Store (zusätzliche Optionen)
# BRAIN_MAX_CONTEXT_CHARS=24000

# Embeddings (Vektoren werden in UWE gespeichert)
# BRAIN_EMBEDDINGS_ENABLED=true
# BRAIN_EMBEDDING_PROVIDER=ollama
# BRAIN_EMBEDDING_MODEL=nomic-embed-text
# BRAIN_EMBEDDING_BASE_URL=http://192.168.178.50:11434
# BRAIN_EMBEDDINGS_STORE=uwe-database

# Mail (SMTP — Secrets nur serverseitig)
# MAIL_ENABLED=true
# MAIL_FROM="UWE <uwe@uweanddragons.org>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_LOG_BODY=false

# Brain Embeddings (RTX computes vectors, UWE stores them permanently)
BRAIN_EMBEDDINGS_ENABLED=true
BRAIN_EMBEDDING_PROVIDER=ollama
BRAIN_EMBEDDING_MODEL=nomic-embed-text
# BRAIN_EMBEDDING_BASE_URL=http://192.168.178.50:11434
BRAIN_EMBEDDINGS_STORE=uwe-database

# Label image generation (optional — provider interface prepared, default: disabled)
# LABEL_IMAGE_PROVIDER=disabled

# Spotify Soundboard (optional — Studio OAuth + Web API playback, one account per world)
# Requires Spotify Premium for playback-control endpoints.
# Create an app at https://developer.spotify.com/dashboard
# Add the redirect URI below to your Spotify app settings.
# oEmbed covers track/playlist/artist without credentials; albums need Client Credentials.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Mail Center (optional — outbound SMTP, Studio only)
# MAIL_ENABLED=true
# MAIL_FROM="UWE <uwe@example.org>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=change-me
# SMTP_PASSWORD=change-me
# MAIL_LOG_BODY=false
# MAIL_USE_MOCK=false

# --- Mail Center (outbound SMTP) ---
# SMTP secrets stay server-side only — never exposed to the Studio UI/API.
# MAIL_ENABLED=true
# MAIL_FROM="UWE <uwe@uweandragons.org>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=change-me
# SMTP_PASSWORD=change-me
# MAIL_LOG_BODY=false
# MAIL_USE_MOCK=false
