{
  "name": "@uwe/rtx-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local RTX inference agent for UWE — proxies chat to Ollama with token protection",
  "type": "module",
  "bin": {
    "uwe-rtx-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-node-tests.mjs",
    "start": "node dist/index.js start",
    "tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rtx-tray.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
