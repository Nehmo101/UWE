# UWE RTX Agent — local inference proxy for the RTX machine
# Copy to .env and adjust for your setup.

# Bind address (prefer localhost or private LAN IP, not 0.0.0.0)
AGENT_HOST=127.0.0.1
AGENT_PORT=8787

# Required shared secret — UWE sends this with every /chat request
AGENT_TOKEN=change-me-to-a-long-random-string

# Enable/disable the agent (false → /health returns disabled, /chat blocked)
AGENT_ENABLED=true

# Ollama backend
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.2

# Optional: command to start Ollama when backend is offline (e.g. "ollama serve")
# START_OLLAMA_COMMAND=ollama serve

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=120

# CORS — comma-separated origins allowed to call the agent
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Never log prompts in production (set true only for local debugging)
LOG_PROMPTS=false
