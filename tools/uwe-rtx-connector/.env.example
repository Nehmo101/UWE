# UWE RTX Host Connector — local worker configuration.
# Copy to .env in this folder. The connector connects OUTBOUND to the host;
# it never opens a public port and is never required for UWE to be online.

# Required: this process runs as the connector role.
UWE_RUNTIME_ROLE=rtx-connector

# Required: where the UWE Host lives (public website or LAN address).
UWE_HOST_URL=https://uweanddragons.org

# Required: connector token. Generate it in Studio → System → RTX Connector.
# Only its hash is stored on the host; this plaintext is shown once.
UWE_CONNECTOR_TOKEN=uwec_replace_me

# Optional: friendly name shown in the host UI.
UWE_CONNECTOR_NAME=RTX Laptop

# Optional: master switch for claiming jobs (default true).
UWE_CONNECTOR_QUEUE_ENABLED=true

# Optional: force the advertised capabilities (comma separated). Leave empty to
# auto-detect. Known: audio_local,spotify_connect,llm_local,image_generation,
# embedding_local,file_cache,system_info
# UWE_CONNECTOR_CAPABILITIES=

# Optional capability opt-ins (auto-detection fallbacks).
UWE_CONNECTOR_AUDIO=true
# UWE_CONNECTOR_SPOTIFY=true
# UWE_CONNECTOR_IMAGE=false

# Optional: command used to play local sounds (source is appended as last arg).
# Example: mpv --no-video --really-quiet
# UWE_CONNECTOR_AUDIO_CMD=

# Optional: local AI providers probed during discovery.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# LLAMACPP_BASE_URL=http://127.0.0.1:8080

# Optional: spotify device the connector controls (enables spotify_connect).
# SPOTIFY_DEVICE_ID=

# Optional: loop timing overrides (host values take precedence).
# UWE_CONNECTOR_POLL_MS=2000
# UWE_CONNECTOR_HEARTBEAT_MS=15000
