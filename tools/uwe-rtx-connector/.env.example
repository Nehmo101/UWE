# UWE RTX Host Connector - local worker configuration.
# Copy to .env in this folder. The connector connects OUTBOUND to the host;
# it never opens a public port and is never required for UWE to be online.

# Required: this process runs as the connector role.
UWE_RUNTIME_ROLE=rtx-connector

# Required: where the UWE Host lives (public website or LAN address).
UWE_HOST_URL=https://uweanddragons.org

# Required: connector token. Generate it in Studio -> System -> RTX Connector.
# Only its hash is stored on the host; this plaintext is shown once.
UWE_CONNECTOR_TOKEN=uwec_replace_me

# Optional: friendly name shown in the host UI.
UWE_CONNECTOR_NAME=RTX Laptop

# Optional: master switch for claiming jobs (default true).
UWE_CONNECTOR_QUEUE_ENABLED=true

# Optional: restrict advertised capabilities (comma separated). Leave empty to
# auto-detect. Forced entries are still filtered against executable backends.
# Known: audio_local,spotify_connect,llm_local,image_generation,
# embedding_local,file_cache,label_printing,system_info
# UWE_CONNECTOR_CAPABILITIES=

# Optional capability opt-ins. A switch alone is not enough: the connector only
# advertises a capability when a real executor/backend is configured.
UWE_CONNECTOR_AUDIO=true
UWE_CONNECTOR_SPOTIFY=true
UWE_CONNECTOR_IMAGE=true
UWE_CONNECTOR_PRINT=true

# Optional: JSON array of local printers for the label_printing capability.
# When empty the connector auto-discovers printers via CUPS `lpstat -p`.
# Format: [{"id":"<cups-printer-id>","name":"<display name>"}]
#
# Single label printer (Zebra LP 2844):
#   UWE_CONNECTOR_PRINTERS=[{"id":"zebra-lp2844","name":"Zebra LP 2844 Label"}]
# Multiple printers:
#   UWE_CONNECTOR_PRINTERS=[{"id":"zebra-lp2844","name":"Zebra LP 2844"},{"id":"hp-lj","name":"HP LaserJet"}]
#
# If unset and CUPS is not available, label_printing is not advertised.
# UWE_CONNECTOR_PRINTERS=

# Optional: custom print command for label jobs.
# The connector appends --printer <id> --file <path/to/doc.pdf>.
# Default (unset): CUPS `lp -d <id> <file>`.
# Linux/macOS CUPS example: leave unset (auto-detected from lpstat -p).
# Custom example: UWE_CONNECTOR_PRINT_CMD=lpr -P
# Windows spooler wrapper: UWE_CONNECTOR_PRINT_CMD=node ./print-win.mjs
# UWE_CONNECTOR_PRINT_CMD=

# Optional: command used to play local sounds (sourceUrl/url/path/source is
# appended as last arg). audio_local is advertised only when this is set.
# Example: mpv --no-video --really-quiet
# UWE_CONNECTOR_AUDIO_CMD=

# Optional: Spotify Connect backend. spotify_connect is advertised only when both
# SPOTIFY_DEVICE_ID and an access token are present.
# SPOTIFY_DEVICE_ID=
# SPOTIFY_ACCESS_TOKEN=
# UWE_CONNECTOR_SPOTIFY_ACCESS_TOKEN=

# Optional: image generation backend. image_generation is advertised only when
# this command is set. The connector sends the job payload as JSON on stdin and
# expects JSON or text on stdout.
# Example: node ./local-image-worker.mjs
# UWE_CONNECTOR_IMAGE_CMD=

# Optional: local AI providers probed during discovery.
# Only reachable Ollama models currently enable llm_local / embedding_local.
# Cloud providers remain behind the UWE host/interface instead of this connector.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# LLAMACPP_BASE_URL=http://127.0.0.1:8080

# Optional: loop timing overrides (host values take precedence).
# UWE_CONNECTOR_POLL_MS=2000
# UWE_CONNECTOR_HEARTBEAT_MS=15000

# Optional: client data directory. Holds the model profile store
# (model-store.json), recent job history (job-history.json), and the rolling
# log file (connector.log). The Tauri client sets this automatically; the CLI
# falls back to ~/.uwe-rtx-connector when unset. Only the models you enable in
# the client are advertised to the host.
# UWE_CONNECTOR_CLIENT_DATA_DIR=
