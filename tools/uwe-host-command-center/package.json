{
  "name": "@uwe/host-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone local host telemetry client for the UWE Linux Command Center",
  "type": "module",
  "bin": {
    "uwe-host-command-center": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-node-tests.mjs",
    "bundle-cli": "node scripts/bundle-cli.mjs"
  },
  "dependencies": {
    "@uwe/auth": "workspace:*",
    "@uwe/cloudflare-edge": "workspace:*",
    "@uwe/connector-client-config": "workspace:*",
    "@uwe/database": "workspace:*",
    "@uwe/doc-import": "workspace:*",
    "@uwe/host-cockpit": "workspace:*",
    "@uwe/host-monitor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@uwe/config": "workspace:*",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
