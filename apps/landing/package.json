{
  "name": "@uwe/landing",
  "version": "0.1.0",
  "private": true,
  "description": "UWE Landing — öffentliche Startseite auf dem Apex-Origin (uwe.example)",
  "scripts": {
    "copy:scenes": "node --import tsx ../../scripts/copy-scenes.mjs",
    "dev": "node --import tsx ../../scripts/copy-scenes.mjs && next dev --port 3103 --webpack",
    "build": "node --import tsx ../../scripts/copy-scenes.mjs && next build --webpack",
    "start": "next start --port 3103",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@uwe/auth": "workspace:*",
    "@uwe/config": "workspace:*",
    "@uwe/database": "workspace:*",
    "@uwe/env": "workspace:*",
    "@uwe/security": "workspace:*",
    "@uwe/shared-ui": "workspace:*",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
