{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UWE RTX Connector Client",
  "version": "0.1.0",
  "identifier": "local.uwe.rtx-connector-client",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UWE RTX Connector Client",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "UWE",
    "icon": ["icons/icon.svg", "icons/icon.ico"],
    "shortDescription": "Local desktop client for the UWE RTX Host Connector",
    "longDescription": "Windows desktop client for the optional outbound UWE RTX Host Connector. It manages local connector configuration, model downloads, runner visibility, jobs and logs."
  }
}
