{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UWE RTX Connector Client",
  "version": "0.1.0",
  "identifier": "local.uwe.rtx-connector-client",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UWE RTX Connector Client",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg", "app"],
    "publisher": "UWE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.svg",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "Local desktop client for the UWE RTX Host Connector",
    "longDescription": "Desktop client for the optional outbound UWE RTX Host Connector. Windows (MSI/NSIS), Linux (deb/AppImage), and macOS (dmg/app) bundles are supported when built on the matching host OS."
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/Nehmo101/UWE/releases/download/rtx-connector-v{{version}}/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
