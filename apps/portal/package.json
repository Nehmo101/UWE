{
  "name": "@uwe/portal",
  "version": "0.1.0",
  "private": true,
  "description": "UWE Portal \u2014 player-facing campaign wiki and handouts",
  "scripts": {
    "copy:scenes": "node --import tsx ../../scripts/copy-scenes.mjs",
    "copy:terra": "node ../../scripts/copy-terra.mjs",
    "dev": "node --import tsx ../../scripts/copy-scenes.mjs && node ../../scripts/copy-terra.mjs && next dev --port 3001",
    "build": "node --import tsx ../../scripts/copy-scenes.mjs && node ../../scripts/copy-terra.mjs && next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@uwe/assets": "workspace:*",
    "@uwe/auth": "workspace:*",
    "@uwe/database": "workspace:*",
    "@uwe/player-hub": "workspace:*",
    "@uwe/dnd-api": "workspace:*",
    "@uwe/env": "workspace:*",
    "@uwe/security": "workspace:*",
    "@uwe/shared-ui": "workspace:*",
    "@uwe/shared-utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.22.0",
    "next": "^15.3.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@uwe/config": "workspace:*",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
