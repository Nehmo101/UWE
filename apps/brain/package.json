{
  "name": "@uwe/brain",
  "version": "0.1.0",
  "private": true,
  "description": "UWE Brain — private daily-admin and personal-knowledge app, gated on the brain checkbox (local/LAN only)",
  "scripts": {
    "copy:scenes": "node --import tsx ../../scripts/copy-scenes.mjs",
    "dev": "node --import tsx ../../scripts/copy-scenes.mjs && next dev --port 3002 --hostname 127.0.0.1 --webpack",
    "build": "node --import tsx ../../scripts/copy-scenes.mjs && next build --webpack && node ../../scripts/materialize-standalone-prisma-deps.mjs brain",
    "start": "next start --port 3002 --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@uwe/ai-brain": "workspace:*",
    "@uwe/assets": "workspace:*",
    "@uwe/auth": "workspace:*",
    "@uwe/brain-assistant": "workspace:*",
    "@uwe/calendar": "workspace:*",
    "@uwe/config": "workspace:*",
    "@uwe/daily-cockpit": "workspace:*",
    "@uwe/database": "workspace:*",
    "@uwe/env": "workspace:*",
    "@uwe/host-cockpit": "workspace:*",
    "@uwe/mail": "workspace:*",
    "@uwe/mail-core": "workspace:*",
    "@uwe/product-contracts": "workspace:*",
    "@uwe/security": "workspace:*",
    "@uwe/shared-ui": "workspace:*",
    "isomorphic-dompurify": "^3.20.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
