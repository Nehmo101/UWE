{
  "name": "@uwe/studio",
  "version": "0.1.0",
  "private": true,
  "description": "UWE Studio — DM campaign editor and world management",
  "scripts": {
    "copy:scenes": "node --import tsx ../../scripts/copy-scenes.mjs",
    "copy:terra": "node ../../scripts/copy-terra.mjs",
    "dev": "node --import tsx ../../scripts/copy-scenes.mjs && node ../../scripts/copy-terra.mjs && next dev --port 3000 --webpack",
