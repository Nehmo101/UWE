{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UWE Command Center",
  "version": "0.2.0",
  "identifier": "local.uwe.engine-connector-client",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UWE Command Center",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "UWE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.svg",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "All-in-one control center for UWE hosting and Maschinenraum workloads",
    "longDescription": "UWE Command Center installs, configures, starts, monitors, backs up, and connects a local UWE host with Maschinenraum workloads from one desktop application.",
    "resources": [
      "resources/host-runtime"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/Nehmo101/UWE/releases/download/uwe-v{{version}}/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
