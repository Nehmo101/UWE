{
  "name": "uwe",
  "version": "0.1.0",
  "private": true,
  "description": "Universeller Welten-Editor — self-hosted campaign brain and world wiki",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:release": "pnpm --filter @uwe/database db:generate && turbo run build",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @uwe/database db:generate && turbo run test && node --import tsx --test scripts/selfhost.test.ts scripts/release.test.ts scripts/windows-installer.test.ts",
    "release:check": "node --import tsx --test scripts/release.test.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev:studio": "pnpm --filter @uwe/studio dev",
    "dev:portal": "pnpm --filter @uwe/portal dev",
    "export:static": "pnpm --filter @uwe/database db:generate && node --import tsx packages/static-export/src/cli.ts",
    "backup:create": "pnpm --filter @uwe/database db:generate && node --import tsx packages/backup/src/cli.ts",
    "db:migrate": "pnpm --filter @uwe/database db:migrate",
    "db:seed": "pnpm --filter @uwe/database db:seed",
    "installer:windows:build": "pnpm --filter @uwe/windows-installer run build && node tools/windows-installer/src/build-exe.mjs",
    "installer:windows:dry-run": "pnpm --filter @uwe/windows-installer run build && node tools/windows-installer/dist/cli.js dry-run --mode dev --repo ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "tsx": "^4.22.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  }
}
