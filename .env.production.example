# UWE — Production on an old Linux laptop (Cloudflare Tunnel, no router ports)
# Copy to /etc/uwe/uwe.env (mode 600, root:uwe) and adjust every CHANGE_ME value.
# See docs/deployment-hardening.md for the full setup guide.

NODE_ENV=production

# --- Secrets (generate before first start) ---
# openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
# openssl rand -base64 32
STUDIO_API_TOKEN=CHANGE_ME_generate_with_openssl_rand_base64_32

# Never seed demo data in production
RUN_DB_SEED=false

# --- Public URL / Cloudflare Tunnel (Split Hostnames — empfohlen) ---
PUBLIC_APP_URL=https://uweanddragons.org
NEXT_PUBLIC_PORTAL_URL=https://portal.uweanddragons.org
NEXT_PUBLIC_STUDIO_URL=https://studio.uweanddragons.org
TRUST_PROXY=true
CLOUDFLARE_TUNNEL=true
# Studio access is gated by the UWE login (e-mail sign-in) — no separate
# Cloudflare Access sign-in is required. For a "Verify you are human" gate in
# front of the sites, enable a Cloudflare Managed Challenge at the edge (WAF)
# and/or the in-app Turnstile widget below.

# --- "Ich bin ein Mensch" check (Cloudflare Turnstile) ---
# Optional: shows a "Verify you are human" widget on the login forms and
# verifies it server-side. Create keys at Cloudflare → Turnstile (managed mode).
# Leave empty to disable. Use real keys here — never the Cloudflare test keys.
# TURNSTILE_SITE_KEY=CHANGE_ME_turnstile_site_key
# TURNSTILE_SECRET_KEY=CHANGE_ME_turnstile_secret_key

# Legacy unified-path (nur für Alt-Installationen — nicht für neue Deployments):
# STUDIO_PATH=/studio
# PORTAL_PATH=/
# NEXT_PUBLIC_STUDIO_PATH=/studio

# --- Portal auth (required when exposed via tunnel) ---
AUTH_REQUIRED=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# --- Player preview (keep locked down) ---
PLAYER_PREVIEW_PUBLIC=false
PLAYER_PREVIEW_REQUIRE_TOKEN=true
PLAYER_PREVIEW_ALLOW_DM_ONLY=false

# --- App ports (localhost only — cloudflared connects here) ---
STUDIO_PORT=3000
PORTAL_PORT=3001

# --- Persistent data (dedicated directories, separate from backups mount) ---
UWE_DATA_DIR=/var/lib/uwe
DATABASE_URL=file:/var/lib/uwe/uwe.db
UWE_UPLOADS_DIR=/var/lib/uwe/uploads
UWE_EXPORT_DIR=/var/lib/uwe/exports
UWE_BACKUP_DIR=/var/backups/uwe

# --- AI / RTX (local network only — never expose RTX to the tunnel) ---
AI_INFERENCE_ALLOW_PUBLIC_URL=false
# Active local-inference: direct Ollama/LM Studio via AI_INFERENCE_BASE_URL, plus the
# outbound RTX Host Connector (tools/uwe-rtx-connector). See docs/rtx-connector.md.
# Optional direct RTX worker URL/token for the remaining image-worker/security-boundary path:
# RTX_BASE_URL=http://192.168.178.50:8765
# RTX_SERVICE_TOKEN=CHANGE_ME_rtx_worker_token

# --- Mail (optional) ---
# MAIL_ENABLED=true
# MAIL_FROM="UWE <uwe@example.org>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# MAIL_LOG_BODY=false

# --- Build metadata (optional, set by deploy script) ---
# UWE_COMMIT=abc1234

# --- Host update from Studio (/hardware, Owner only) ---
# Requires setup-uwe-host.sh to install uwe-host-update.service + sudoers rule.
# UWE_HOST_UPDATE_ENABLED=true
