; Godot-Projekt des Terra-Spikes.
;
; Bewusst minimal: dieser Baum soll MESSEN, nicht wachsen. Kein Editor, keine
; Werkzeuge, kein Ghibli-Look — siehe terra-godot/README.md.
;
; Forward Plus waere fuer den Web-Export falsch: dort traegt nur der mobile
; bzw. der kompatible Renderer. `gl_compatibility` ist die Betriebsart, die
; im Browser ueber WebGL2 laeuft, und genau die soll gemessen werden.

config_version=5

[application]

config/name="terra-godot"
config/description="Messspike: kann Godot Terras v5-Kartenformat lesen und zeichnen?"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/main_scene="res://schau.tscn"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
