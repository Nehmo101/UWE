{
  "name": "@uwe/mail-core",
  "version": "0.1.0",
  "private": true,
  "description": "UWE Mail Core — framework-agnostic mail primitives (SMTP transport, compose, IMAP sync, MIME decode) usable from any UWE package without a database dependency",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./portal-types": "./src/mail-portal-types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-node-tests.mjs"
  },
  "dependencies": {
    "@uwe/assets": "workspace:*",
    "@uwe/env": "workspace:*",
    "imapflow": "^1.6.4",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.32",
    "@types/nodemailer": "^6.4.17",
    "@uwe/config": "workspace:*",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
