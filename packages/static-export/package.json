{
  "name": "@uwe/static-export",
  "version": "0.1.0",
  "private": true,
  "description": "Static HTML export for UWE player portal content",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "export": "tsx src/cli.ts"
  },
  "dependencies": {
    "@uwe/assets": "workspace:*",
    "@uwe/database": "workspace:*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@uwe/config": "workspace:*",
    "esbuild": "0.28.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
