{
  "name": "@uwe/database",
  "version": "0.1.0",
  "private": true,
  "description": "UWE Core database layer (schema, migrations, queries)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./page-types": "./src/page-types.ts",
    "./graph-types": "./src/graph-types.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./campaign-radar": "./src/campaign-radar-service.ts",
    "./player-questions": "./src/player-question-service.ts",
    "./health-metrics": "./src/health-metrics-service.ts",
    "./magic-item": "./src/magic-item-model.ts",
    "./magic-item-service": "./src/magic-item-service.ts",
    "./page-bulk": "./src/page-bulk-service.ts",
    "./prompt-library": "./src/prompt-library-service.ts",
    "./knowledge-assistant": "./src/knowledge-assistant-service.ts",
    "./maintenance-gate": "./src/maintenance-gate.ts",
    "./settings-service": "./src/settings-service.ts",
    "./mail-settings": "./src/mail-settings.ts",
    "./mail-smtp-settings": "./src/mail-smtp-settings.ts",
    "./deployment": "./src/deployment.ts",
    "./enums": "./src/enums.ts",
    "./content-access": "./src/content-access.ts",
    "./capture-constants": "./src/capture-constants.ts",
    "./import-constants": "./src/import-constants.ts",
    "./label-elements": "./src/label-elements.ts",
    "./generator-types": "./src/generator-types.ts",
    "./contract-expense-utils": "./src/contract-expense-utils.ts",
    "./finance-overview": "./src/finance-overview-service.ts",
    "./continue-work": "./src/continue-work-service.ts",
    "./maintenance": "./src/maintenance-service.ts",
    "./theme-preferences": "./src/theme-preferences.ts",
    "./integrations-ui": "./src/integrations-ui.ts",
    "./personal-brain-constants": "./src/personal-brain-constants.ts",
    "./dev-idea-constants": "./src/dev-idea-constants.ts",
    "./dashboard-layout": "./src/dashboard-layout-types.ts",
    "./test-helpers": "./src/test-helpers.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-node-tests.mjs",
    "db:generate": "prisma generate && prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:safe": "node scripts/db-deploy-safe.mjs",
    "db:deploy:postgres": "prisma migrate deploy --config prisma.postgres.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@uwe/assets": "workspace:*",
    "@uwe/atlas": "workspace:*",
    "@uwe/auth": "workspace:*",
    "@uwe/connector": "workspace:*",
    "@uwe/env": "workspace:*",
    "@uwe/mail": "workspace:*",
    "@uwe/shared-utils": "workspace:*",
    "@uwe/soundboard": "workspace:*",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.19.21",
    "@types/pg": "^8.20.0",
    "@uwe/config": "workspace:*",
    "adm-zip": "^0.5.16",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
