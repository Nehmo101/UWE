{
  "name": "@uwe/database",
  "version": "0.1.0",
  "private": true,
  "description": "UWE Core database layer (schema, migrations, queries)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./test-helpers": "./src/test-helpers.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No lint configured yet\"",
    "test": "prisma generate && node --import tsx --test 'src/**/*.test.ts'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@uwe/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@uwe/config": "workspace:*",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
