{
  "name": "@uwe/database",
  "version": "0.1.0",
  "private": true,
  "description": "UWE Core database layer (schema, migrations, queries)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./page-types": "./src/page-types.ts",
    "./graph-types": "./src/graph-types.ts",
    "./graph-service": "./src/graph-service.ts",
    "./page-viewer-service": "./src/page-viewer-service.ts",
    "./client": "./src/client.ts",
    "./brain-client": "./src/brain-client.ts",
    "./passkeys": "./src/passkey-credential-store.ts",
    "./auth-identities": "./src/auth-identity-service.ts",
    "./login-methods-settings": "./src/login-methods-settings.ts",
    "./connector-service": "./src/connector-service.ts",
    "./server": "./src/server.ts",
    "./terra": "./src/terra-service.ts",
    "./campaign-radar": "./src/campaign-radar-service.ts",
    "./player-questions": "./src/player-question-service.ts",
    "./player-question-notify": "./src/player-question-notify.ts",
    "./health-metrics": "./src/health-metrics-service.ts",
    "./magic-item": "./src/magic-item-model.ts",
    "./magic-item-service": "./src/magic-item-service.ts",
    "./page-bulk": "./src/page-bulk-service.ts",
    "./prompt-library": "./src/prompt-library-service.ts",
    "./prompt-library-utils": "./src/prompt-library-utils.ts",
    "./knowledge-assistant": "./src/knowledge-assistant-service.ts",
    "./maintenance-gate": "./src/maintenance-gate.ts",
    "./settings-service": "./src/settings-service.ts",
    "./mail-settings": "./src/mail-settings.ts",
    "./mail-smtp-settings": "./src/mail-smtp-settings.ts",
    "./token-crypto": "./src/token-crypto.ts",
    "./label-print-queue": "./src/label-print-queue-service.ts",
    "./mail-log-service": "./src/mail-log-service.ts",
    "./mail-account-service": "./src/mail-account-service.ts",
    "./mail-unsubscribe-service": "./src/mail-unsubscribe-service.ts",
    "./mail-prisma-types": "./src/mail-prisma-types.ts",
    "./deployment": "./src/deployment.ts",
    "./enums": "./src/enums.ts",
    "./content-access": "./src/content-access.ts",
    "./capture-constants": "./src/capture-constants.ts",
    "./capture-triage-ui": "./src/capture-triage-ui.ts",
    "./brain-constants": "./src/brain-constants.ts",
    "./import-constants": "./src/import-constants.ts",
    "./label-elements": "./src/label-elements.ts",
    "./generator-types": "./src/generator-types.ts",
    "./contract-expense-utils": "./src/contract-expense-utils.ts",
    "./finance-overview": "./src/finance-overview-service.ts",
    "./account-session": "./src/account-session-service.ts",
    "./world-calendar-settings": "./src/world-calendar-settings.ts",
    "./wiki-quality": "./src/wiki-quality-service.ts",
    "./continue-work": "./src/continue-work-service.ts",
    "./maintenance": "./src/maintenance-service.ts",
    "./log-retention": "./src/maintenance/log-retention-service.ts",
    "./theme-preferences": "./src/theme-preferences.ts",
    "./custom-theme-preferences": "./src/custom-theme-preferences.ts",
    "./integrations-ui": "./src/integrations-ui.ts",
    "./personal-brain-constants": "./src/personal-brain-constants.ts",
    "./dev-idea-constants": "./src/dev-idea-constants.ts",
    "./dashboard-layout": "./src/dashboard-layout-types.ts",
    "./host-restart": "./src/host-restart-service.ts",
    "./test-helpers": "./src/test-helpers.ts",
    "./first-run-setup": "./src/first-run-setup-service.ts",
    "./first-run-setup-types": "./src/first-run-setup-types.ts",
    "./family-client": "./src/family-client.ts",
    "./family-service": "./src/family-service.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-node-tests.mjs",
    "db:generate": "prisma generate && prisma generate --schema=prisma/schema.postgresql.prisma && prisma generate --schema=prisma/brain/schema.prisma && prisma generate --schema=prisma/family/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:migrate:brain": "prisma migrate dev --config prisma.brain.config.ts",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:brain": "prisma migrate deploy --config prisma.brain.config.ts",
    "db:deploy:safe": "node scripts/db-deploy-safe.mjs",
    "db:deploy:postgres": "prisma migrate deploy --config prisma.postgres.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:migrate:family": "prisma migrate dev --config prisma.family.config.ts",
    "db:deploy:family": "prisma migrate deploy --config prisma.family.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@uwe/assets": "workspace:*",
    "@uwe/auth": "workspace:*",
    "@uwe/connector": "workspace:*",
    "@uwe/env": "workspace:*",
    "@uwe/mail-core": "workspace:*",
    "@uwe/shared-utils": "workspace:*",
    "@uwe/soundboard": "workspace:*",
    "isomorphic-dompurify": "^3.18.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.19.21",
    "@types/pg": "^8.20.0",
    "@uwe/config": "workspace:*",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
