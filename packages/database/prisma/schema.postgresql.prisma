  createdAt       DateTime             @default(now()) @map("created_at")

  project ImageStudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([projectId, versionNumber])
  @@map("image_studio_versions")
}

model ImageStudioLink {
  id         String                    @id @default(cuid())
  projectId  String                    @map("project_id")
  targetType ImageStudioLinkTargetType @map("target_type")
  targetId   String                    @map("target_id")
  createdAt  DateTime                  @default(now()) @map("created_at")

  project ImageStudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("image_studio_links")
}

model CalendarFeed {
  id          String                @id @default(cuid())
