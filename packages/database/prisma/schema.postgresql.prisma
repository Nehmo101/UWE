// Workflow slots that map a UWE use-case to a specific connector model.
enum ConnectorWorkflowSlot {
  chat
  code
  dnd
  analysis
  embedding
  vision
}

model Connector {
  id              String          @id @default(cuid())
  name            String
  type            ConnectorType   @default(rtx_connector)
  // Only the SHA-256 hash of the connector token is ever stored — never plaintext.
  tokenHash       String          @unique @map("token_hash")
  status          ConnectorStatus @default(offline)
  disabled        Boolean         @default(false)
  queueEnabled    Boolean         @default(true) @map("queue_enabled")
  capabilities    Json?
  models          Json?
  printers        Json?
  version         String?
  currentJobs     Int             @default(0) @map("current_jobs")
  lastError       String?         @map("last_error")
  lastHeartbeatAt DateTime?       @map("last_heartbeat_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  claimedJobs      ConnectorJob[]
  workflowDefaults ConnectorWorkflowDefault[]

  @@index([status])
  @@map("connectors")
}

// One default connector model per workflow slot. The host picks these models
// for the matching use-case; the connector stays the source of truth for the
// model metadata reported on heartbeat.
model ConnectorWorkflowDefault {
  id          String                @id @default(cuid())
  slot        ConnectorWorkflowSlot @unique
  connectorId String                @map("connector_id")
  modelId     String                @map("model_id")
