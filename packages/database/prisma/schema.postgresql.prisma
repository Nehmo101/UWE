model User {
  id                  String     @id @default(cuid())
  displayName         String     @map("display_name")
  email               String?    @unique
  passwordHash        String?    @map("password_hash")
  role                UserRole   @default(player)
  status              UserStatus @default(active)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  forcePasswordChange Boolean    @default(false) @map("force_password_change")
  resetTokenHash      String?    @map("reset_token_hash")
  resetTokenExpiresAt DateTime?  @map("reset_token_expires_at")
  inviteTokenHash     String?    @map("invite_token_hash")
  inviteTokenExpiresAt DateTime? @map("invite_token_expires_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  sessions            Session[]
  worldMemberships    WorldMembership[]
  pageAccess          PagePlayerAccess[]
  sessionUnlocks      SessionUnlock[]
  playerNotes         PlayerNote[]
  aiRuns              AiRun[]
  mailRecipients      MailRecipient[]
  jobs                Job[]
  apiTokens           ApiToken[]
  twoFactorSecret     TwoFactorSecret?
  twoFactorChallenges TwoFactorChallenge[]
  authIdentities      AuthIdentity[]
  contentReviewsProposed ContentReview[] @relation("ContentReviewProposedBy")
  contentReviewsReviewed ContentReview[] @relation("ContentReviewReviewedBy")
  aiUserGrant          AiUserGrant?
  aiUsageLogs          AiUsageLog[]
  reviewComments         ReviewComment[]
  dashboardLayouts       DashboardLayout[]

  @@map("users")
}

/// Per-user dashboard widget layout (Studio Today, Portal world overview, …).
model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  pageKey   String   @map("page_key")
  widgets   String
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
  @@index([userId])
  @@map("dashboard_layouts")
}

/// External identity provider link (OAuth prep — no auto-provisioning).
model AuthIdentity {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("auth_identities")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("sessions")
}

model WorldMembership {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  worldId       String          @map("world_id")
  role          WorldMemberRole
  characterName String?         @map("character_name")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
  @@map("world_memberships")
}

model PagePlayerAccess {
  id     String @id @default(cuid())
  pageId String @map("page_id")
  userId String @map("user_id")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("page_player_access")
}

model SessionUnlock {
  id           String   @id @default(cuid())
  pageId       String   @map("page_id")
  userId       String   @map("user_id")
  unlockedAt   DateTime @default(now()) @map("unlocked_at")
  sessionLabel String?  @map("session_label")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("session_unlocks")
}

model World {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  guestModeEnabled     Boolean  @default(false) @map("guest_mode_enabled")
  guestCommentsEnabled Boolean  @default(false) @map("guest_comments_enabled")
  isSandbox            Boolean  @default(false) @map("is_sandbox")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  campaigns        Campaign[]
  pages            Page[]
  assets           Asset[]
  worldMemberships WorldMembership[]
  gameSessions     GameSession[]
  labelTemplates    LabelTemplate[]
  labels            Label[]
  printLists        PrintList[]
  soundboardButtons SoundboardButton[]
  playerNotes       PlayerNote[]
  shareLinks        ShareLink[]
  spotifyConnection SpotifyConnection?
  brainDocuments    BrainDocument[]
  brainFacts        BrainFact[]
  brainLinks        BrainLink[]
  aiRuns            AiRun[]
  mailTemplates       MailTemplate[]
  mailRecipientGroups MailRecipientGroup[]
  mailMessageLogs     MailMessageLog[]
  mailDrafts          MailDraft[]
  captureEntries      CaptureEntry[]
  personalProjects    PersonalProject[]
  workshopProjects    WorkshopProject[]
  generatorPresets    GeneratorPreset[]
  generatorOutputs    GeneratorOutput[]
  imageStudioProjects ImageStudioProject[]
  calendarEvents      CalendarEvent[]
  dndBeyondReferences DndBeyondReference[]
  researchSessions    ResearchSession[]
  contentReviews      ContentReview[]
  worldCalendar       WorldCalendar?
  worldEvents         WorldEvent[]
  factionStates       FactionState[]

  @@map("worlds")
}

model Campaign {
  id          String   @id @default(cuid())
  worldId     String   @map("world_id")
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  world        World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  pages             Page[]
  assets            Asset[]
  gameSessions      GameSession[]
  labels            Label[]
  printLists        PrintList[]
  soundboardButtons SoundboardButton[]
  playerNotes       PlayerNote[]
  brainDocuments    BrainDocument[]
  brainFacts        BrainFact[]

  @@unique([worldId, slug])
  @@map("campaigns")
}

model Page {
  id              String             @id @default(cuid())
  worldId         String             @map("world_id")
  campaignId      String?            @map("campaign_id")
  parentPageId    String?            @map("parent_page_id")
  title           String
  slug            String
  type            PageType
  summary         String?
  visibility      Visibility         @default(private)
  publishStatus   PublishStatus      @default(draft) @map("publish_status")
  secretLevel     SecretLevel        @default(none) @map("secret_level")
  revealState     RevealState        @default(hidden) @map("reveal_state")
  canonicalStatus CanonicalStatus    @default(draft) @map("canonical_status")
  prepStatus      DungeonPrepStatus? @map("prep_status")
  tags            Json?
  aliases         Json?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  world            World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  parentPage       Page?              @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages       Page[]             @relation("PageHierarchy")
  contentBlocks    ContentBlock[]
  outgoingLinks    PageLink[]         @relation("SourcePage")
  incomingLinks    PageLink[]         @relation("TargetPage")
  playerAccess       PagePlayerAccess[]
  sessionUnlocks     SessionUnlock[]
  gameSessionLinks       GameSessionPageLink[]
  soundboardButtonLinks  SoundboardButtonPageLink[]
  assetPageLinks         AssetPageLink[]
  playerNotes            PlayerNote[]
  brainDocuments         BrainDocument[]
  brainFacts             BrainFact[]
  aiRuns                 AiRun[]
  captureEntries         CaptureEntry[]
  personalProjects       PersonalProject[]
  workshopProjects       WorkshopProject[]
  generatorOutputs       GeneratorOutput[]
  dndBeyondReferences    DndBeyondReference[]
  versions               PageVersion[]
  worldEventLinks        WorldEventEntityLink[]
  factionState           FactionState?

  @@unique([worldId, slug])
  @@index([parentPageId])
  @@map("pages")
}

model WorldCalendar {
  id           String   @id @default(cuid())
  worldId      String   @unique @map("world_id")
  name         String   @default("Weltkalender")
  months       Json
  daysPerWeek  Int      @default(7) @map("days_per_week")
  dayNames     Json?    @map("day_names")
  currentDate  Json     @map("current_date")
  epochLabel   String?  @map("epoch_label")
  settings     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  world  World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  events WorldEvent[]

  @@map("world_calendars")
}

model WorldEvent {
  id                 String               @id @default(cuid())
  worldId            String               @map("world_id")
  calendarId         String?              @map("calendar_id")
  inGameDate         Json                 @map("in_game_date")
  title              String
  summaryPlayer      String?              @map("summary_player")
  summaryDm          String?              @map("summary_dm")
  visibility         Visibility           @default(private)
  secretLevel        SecretLevel          @default(none) @map("secret_level")
  sourceType         WorldEventSourceType @default(manual) @map("source_type")
  sourceAiProposalId String?              @map("source_ai_proposal_id")
  gameSessionId      String?              @map("game_session_id")
  sortOrder          Int                  @default(0) @map("sort_order")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  world       World                  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  calendar    WorldCalendar?         @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  gameSession GameSession?           @relation(fields: [gameSessionId], references: [id], onDelete: SetNull)
  entityLinks WorldEventEntityLink[]

  @@index([worldId, sortOrder])
  @@map("world_events")
}

model WorldEventEntityLink {
  id        String               @id @default(cuid())
  eventId   String               @map("event_id")
  pageId    String               @map("page_id")
  role      WorldEventEntityRole @default(involved)
  createdAt DateTime             @default(now()) @map("created_at")

  event WorldEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  page  Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([eventId, pageId, role])
  @@index([pageId])
  @@map("world_event_entity_links")
}

model FactionState {
  id            String   @id @default(cuid())
  worldId       String   @map("world_id")
  pageId        String   @unique @map("page_id")
  goals         Json?
  resources     Json?
  relationships Json?
  agenda        String   @default("")
  powerLevel    Int?     @map("power_level")
  notes         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  page  Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([worldId])
  @@map("faction_states")
}

model GameSession {
  id              String            @id @default(cuid())
  worldId         String            @map("world_id")
  campaignId      String?           @map("campaign_id")
  title           String
  sessionNumber   Int               @map("session_number")
  date            DateTime?         @map("date")
  status          GameSessionStatus @default(planned)
  summaryDm       String?           @map("summary_dm")
  summaryPlayer   String?           @map("summary_player")
  notes           String?
  openPlots       String?           @map("open_plots")
  playerDecisions String?           @map("player_decisions")
  recapPublished         Boolean           @default(false) @map("recap_published")
  playerVisibleSchedule  Boolean           @default(false) @map("player_visible_schedule")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  world        World                 @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign     Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  linkedPages  GameSessionPageLink[]
  playerNotes  PlayerNote[]
  brainDocuments BrainDocument[]
  brainFacts     BrainFact[]
  aiRuns         AiRun[]
  calendarEvents CalendarEvent[]
  worldEvents    WorldEvent[]

  @@index([worldId, sessionNumber])
  @@map("game_sessions")
}

model GameSessionPageLink {
  id            String   @id @default(cuid())
  gameSessionId String   @map("game_session_id")
  pageId        String   @map("page_id")
  createdAt     DateTime @default(now()) @map("created_at")

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([gameSessionId, pageId])
  @@map("game_session_page_links")
}

model ContentBlock {
  id         String           @id @default(cuid())
  pageId     String           @map("page_id")
  assetId    String?          @map("asset_id")
  type       ContentBlockType
  sortOrder  Int              @map("sort_order")
  content     String           @default("")
  visibility  Visibility       @default(private)
  secretLevel SecretLevel      @default(none) @map("secret_level")
  revealState RevealState      @default(hidden) @map("reveal_state")
  metadata    Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([pageId, sortOrder])
  @@index([assetId])
  @@map("content_blocks")
}

model Asset {
  id          String     @id @default(cuid())
  worldId     String     @map("world_id")
  campaignId  String?    @map("campaign_id")
  title       String
  description String?
  type        AssetType
  storageKey  String     @map("storage_key")
  mimeType    String?    @map("mime_type")
  size        Int        @default(0)
  visibility  Visibility  @default(private)
  secretLevel SecretLevel @default(none) @map("secret_level")
  revealState RevealState @default(hidden) @map("reveal_state")
  tags        Json?
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  world         World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign      Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pageLinks         AssetPageLink[]
  contentBlocks     ContentBlock[]
  soundboardButtons SoundboardButton[]
  imageStudioVersions ImageStudioVersion[]

  @@index([worldId, type])
  @@map("assets")
}

model AssetPageLink {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  pageId    String   @map("page_id")
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  page  Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([assetId, pageId])
  @@index([pageId])
  @@map("asset_page_links")
}

model PageLink {
  id           String   @id @default(cuid())
  sourcePageId String   @map("source_page_id")
  targetPageId String   @map("target_page_id")
  relationType String   @map("relation_type")
  label        String?
  createdAt    DateTime @default(now()) @map("created_at")

  sourcePage Page @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage Page @relation("TargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@index([sourcePageId])
  @@index([targetPageId])
  @@map("page_links")
}

model LabelTemplate {
  id              String   @id @default(cuid())
  worldId         String?  @map("world_id")
  name            String
  slug            String
  description     String?
  layoutSettings  Json     @map("layout_settings")
  isSystem        Boolean  @default(false) @map("is_system")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  world  World?  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  labels Label[]

  @@unique([worldId, slug])
  @@map("label_templates")
}

model Label {
  id             String           @id @default(cuid())
  worldId        String           @map("world_id")
  campaignId     String?          @map("campaign_id")
  title          String
  sourceType     LabelSourceType  @map("source_type")
  sourceId       String?          @map("source_id")
  templateId     String           @map("template_id")
  content        Json
  layoutSettings Json             @map("layout_settings")
  printStatus    LabelPrintStatus @default(open) @map("print_status")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  world          World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template       LabelTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  printListItems PrintListItem[]

  @@index([worldId, updatedAt])
  @@index([sourceType, sourceId])
  @@map("labels")
}

model PrintList {
  id             String           @id @default(cuid())
  worldId        String           @map("world_id")
  campaignId     String?          @map("campaign_id")
  name           String
  description    String?
  status         LabelPrintStatus @default(open)
  forNextSession Boolean          @default(false) @map("for_next_session")
