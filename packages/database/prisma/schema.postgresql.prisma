  type        CalendarFeedType
  direction   CalendarFeedDirection @default(read_only)
  url         String?
  caldavUrl   String?               @map("caldav_url")
  username    String?
  credentialsEnc String?            @map("credentials_enc")
  enabled     Boolean               @default(true)
  color       String?
  lastSyncAt  DateTime?             @map("last_sync_at")
  syncError   String?               @map("sync_error")
  metadata    Json?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  events CalendarEvent[]

  @@map("calendar_feeds")
}

model CalendarEvent {
  id          String            @id @default(cuid())
  feedId      String?           @map("feed_id")
  worldId     String?           @map("world_id")
  sessionId   String?           @map("session_id")
  title       String
  description String?
  location    String?
  startAt     DateTime          @map("start_at")
  endAt       DateTime?         @map("end_at")
  allDay      Boolean           @default(false) @map("all_day")
  kind        CalendarEventKind @default(personal)
  externalUid String?           @map("external_uid")
  remoteHref  String?           @map("remote_href")
  remoteEtag  String?           @map("remote_etag")
  caldavPending Boolean         @default(false) @map("caldav_pending")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  feed    CalendarFeed? @relation(fields: [feedId], references: [id], onDelete: SetNull)
  world   World?        @relation(fields: [worldId], references: [id], onDelete: SetNull)
  session GameSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([worldId, startAt])
  @@index([feedId, externalUid])
  @@map("calendar_events")
}

model DevAgentJob {
