enum ResearchSessionStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum ResearchContextMode {
  dnd_brain
  life_brain
  open_web
}

model ResearchSession {
  id           String                @id @default(cuid())
  worldId      String?               @map("world_id")
