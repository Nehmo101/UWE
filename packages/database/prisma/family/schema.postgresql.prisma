model FamilyChatConversation {
  id    String          @id @default(cuid())
  title String
  scope FamilyChatScope @default(shared)

  /// Bei `scope = private` die Person, der die Unterhaltung gehört. Bei
  /// `shared` null: dann sieht sie jedes Family-Mitglied. Opaker Scalar — der
  /// Benutzer liegt in uwe.db.
  ownerUserId String? @map("owner_user_id")

  /// Optionaler Modell-Override für genau diese Unterhaltung; null = Standard.
  connectorId String? @map("connector_id")
  modelId     String? @map("model_id")
  modelLabel  String? @map("model_label")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages FamilyChatMessage[]

  @@index([scope, ownerUserId, updatedAt])
  @@map("family_chat_conversations")
}

model FamilyChatMessage {
  id             String         @id @default(cuid())
  conversationId String         @map("conversation_id")
