  spellKey    String   @map("spell_key")
  spellLevel  Int      @default(0) @map("spell_level")
  prepared    Boolean  @default(false)
  source      String?
  displayName String?  @map("display_name")
  school      String?
  description String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, spellKey])
  @@index([characterId])
  @@map("character_spells")
}

model PartyTreasury {
  id         String   @id @default(cuid())
  worldId    String   @unique @map("world_id")
  name       String   @default("Gruppenschatz")
  currencies Json
  notes      String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  world World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  items InventoryItem[]

  @@map("party_treasuries")
}

model InventoryItem {
  id          String   @id @default(cuid())
  worldId     String   @map("world_id")
  characterId String?  @map("character_id")
  treasuryId  String?  @map("treasury_id")
  pageId      String?  @map("page_id")
  name        String
  quantity    Int      @default(1)
  weight      Float?
  value       Json?
  properties  Json?
  notes       String   @default("")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  world     World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  character Character?     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  treasury  PartyTreasury? @relation(fields: [treasuryId], references: [id], onDelete: Cascade)
  page      Page?          @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([worldId])
  @@index([characterId])
  @@index([treasuryId])
  @@map("inventory_items")
}

