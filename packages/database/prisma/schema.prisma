  details     Json?
  undoEntryId String?       @map("undo_entry_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  proposal  AiProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  undoEntry UndoEntry? @relation(fields: [undoEntryId], references: [id], onDelete: SetNull)

  @@index([proposalId, createdAt])
  @@index([aiRunId])
  @@index([worldId, createdAt])
  @@index([undoEntryId])
  @@map("ai_apply_logs")
}

