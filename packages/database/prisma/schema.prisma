model Connector {
  id                   String          @id @default(cuid())
  name                 String
  type                 ConnectorType   @default(engine_connector)
  // Only the SHA-256 hash of the connector token is ever stored — never plaintext.
  tokenHash            String          @unique @map("token_hash")
  status               ConnectorStatus @default(offline)
  disabled             Boolean         @default(false)
  queueEnabled         Boolean         @default(true) @map("queue_enabled")
  // Effective, job-claimable capabilities (reported ∩ allowed policy).
  capabilities         Json?
  // Raw normalized capabilities most recently reported by the connector.
  reportedCapabilities Json?           @map("reported_capabilities")
  // Host/admin allowlist. NULL means unrestricted, [] means deny all.
  allowedCapabilities  Json?           @map("allowed_capabilities")
  models               Json?
  printers             Json?
  version              String?
  currentJobs          Int             @default(0) @map("current_jobs")
  lastError            String?         @map("last_error")
  lastHeartbeatAt      DateTime?       @map("last_heartbeat_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  claimedJobs      ConnectorJob[]
  workflowDefaults ConnectorWorkflowDefault[]

  @@index([status])
  @@map("connectors")
}

