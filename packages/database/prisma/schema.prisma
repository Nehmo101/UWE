  lastSyncAt  DateTime?             @map("last_sync_at")
  syncError   String?               @map("sync_error")
  metadata    Json?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  events CalendarEvent[]

  @@map("calendar_feeds")
}

model CalendarEvent {
  id          String            @id @default(cuid())
  feedId      String?           @map("feed_id")
  worldId     String?           @map("world_id")
  sessionId   String?           @map("session_id")
  title       String
  description String?
  location    String?
  startAt     DateTime          @map("start_at")
  endAt       DateTime?         @map("end_at")
  allDay      Boolean           @default(false) @map("all_day")
  kind        CalendarEventKind @default(personal)
  externalUid String?           @map("external_uid")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  feed    CalendarFeed? @relation(fields: [feedId], references: [id], onDelete: SetNull)
  world   World?        @relation(fields: [worldId], references: [id], onDelete: SetNull)
  session GameSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([worldId, startAt])
  @@index([feedId, externalUid])
  @@map("calendar_events")
}

model DevAgentJob {
  id           String              @id @default(cuid())
  title        String
  prompt       String
  status       DevAgentJobStatus   @default(pending)
  provider     DevAgentJobProvider @default(github_actions)
  branchName   String?             @map("branch_name")
  prUrl        String?             @map("pr_url")
  issueUrl     String?             @map("issue_url")
  githubRunId  String?             @map("github_run_id")
  cursorJobId  String?             @map("cursor_job_id")
  result       Json?
  errorMessage String?             @map("error_message")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  completedAt  DateTime?           @map("completed_at")

  @@index([status, createdAt])
  @@map("dev_agent_jobs")
}

model DndBeyondReference {
  id         String   @id @default(cuid())
  worldId    String   @map("world_id")
  pageId     String?  @map("page_id")
  title      String
  url        String
  entityType String?  @map("entity_type")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  page  Page? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([worldId])
  @@map("dnd_beyond_references")
}

model DndApiCacheEntry {
  id        String         @id @default(cuid())
  provider  DndApiProvider
  cacheKey  String         @map("cache_key")
  payload   Json
  expiresAt DateTime?      @map("expires_at")
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([provider, cacheKey])
  @@index([expiresAt])
  @@map("dnd_api_cache_entries")
}
