// UWE Core data model — structured world knowledge (Source of Truth)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PageType {
  lore
  location
  region
  npc
  faction
  item
  dungeon
  dungeon_level
  room
  encounter
  trap
  puzzle
  loot
  secret
  session
  quest
  handout
  rule
  player_character
  monster
  sound
  map
  note
}

enum DungeonPrepStatus {
  unprepared
  ready
  played
  skipped
}

enum Visibility {
  dm_only
  player_visible
  public
  specific_players
  unlock_after_session
  archived
}

enum PublishStatus {
  draft
  internal
  published
  archived
}

enum CanonicalStatus {
  idea
  draft
  canon
  deprecated
  contradictory
  non_canon
}

enum ContentBlockType {
  rich_text
  html
  image
  gallery
  map
  handout
  sound
  relation
  timeline
  statblock
  gm_note
  player_text
  ai_summary
}

enum AssetType {
  image
  map
  handout
  document
  audio
  video
  other
}

enum UserRole {
  owner
  dm
  player
  guest
}

enum WorldMemberRole {
  owner
  dm
  player
}

enum GameSessionStatus {
  planned
  prepared
  played
  summarized
  archived
}

enum LabelSourceType {
  page
  dungeon_room
  content_block
  asset
  manual
}

enum SoundSourceType {
  local
  youtube
  spotify
}

model User {
  id           String   @id @default(cuid())
  displayName  String   @map("display_name")
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  role         UserRole @default(player)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  worldMemberships WorldMembership[]
  pageAccess       PagePlayerAccess[]
  sessionUnlocks   SessionUnlock[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

model WorldMembership {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  worldId       String          @map("world_id")
  role          WorldMemberRole
  characterName String?         @map("character_name")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
  @@map("world_memberships")
}

model PagePlayerAccess {
  id     String @id @default(cuid())
  pageId String @map("page_id")
  userId String @map("user_id")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("page_player_access")
}

model SessionUnlock {
  id           String   @id @default(cuid())
  pageId       String   @map("page_id")
  userId       String   @map("user_id")
  unlockedAt   DateTime @default(now()) @map("unlocked_at")
  sessionLabel String?  @map("session_label")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("session_unlocks")
}

model World {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  guestModeEnabled Boolean  @default(false) @map("guest_mode_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  campaigns        Campaign[]
  pages            Page[]
  assets           Asset[]
  worldMemberships WorldMembership[]
  gameSessions     GameSession[]
  labelTemplates    LabelTemplate[]
  labels            Label[]
  soundboardButtons SoundboardButton[]

  @@map("worlds")
}

model Campaign {
  id          String   @id @default(cuid())
  worldId     String   @map("world_id")
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  world        World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  pages             Page[]
  assets            Asset[]
  gameSessions      GameSession[]
  labels            Label[]
  soundboardButtons SoundboardButton[]

  @@unique([worldId, slug])
  @@map("campaigns")
}

model Page {
  id              String             @id @default(cuid())
  worldId         String             @map("world_id")
  campaignId      String?            @map("campaign_id")
  parentPageId    String?            @map("parent_page_id")
  title           String
  slug            String
  type            PageType
  summary         String?
  visibility      Visibility         @default(dm_only)
  publishStatus   PublishStatus      @default(draft) @map("publish_status")
  canonicalStatus CanonicalStatus    @default(draft) @map("canonical_status")
  prepStatus      DungeonPrepStatus? @map("prep_status")
  tags            Json?
  aliases         Json?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  world            World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  parentPage       Page?              @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages       Page[]             @relation("PageHierarchy")
  contentBlocks    ContentBlock[]
  outgoingLinks    PageLink[]         @relation("SourcePage")
  incomingLinks    PageLink[]         @relation("TargetPage")
  playerAccess       PagePlayerAccess[]
  sessionUnlocks     SessionUnlock[]
  gameSessionLinks       GameSessionPageLink[]
  soundboardButtonLinks  SoundboardButtonPageLink[]
  assetPageLinks         AssetPageLink[]

  @@unique([worldId, slug])
  @@index([parentPageId])
  @@map("pages")
}

model GameSession {
  id              String            @id @default(cuid())
  worldId         String            @map("world_id")
  campaignId      String?           @map("campaign_id")
  title           String
  sessionNumber   Int               @map("session_number")
  date            DateTime?         @map("date")
  status          GameSessionStatus @default(planned)
  summaryDm       String?           @map("summary_dm")
  summaryPlayer   String?           @map("summary_player")
  notes           String?
  openPlots       String?           @map("open_plots")
  playerDecisions String?           @map("player_decisions")
  recapPublished  Boolean           @default(false) @map("recap_published")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  world        World                 @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign     Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  linkedPages  GameSessionPageLink[]

  @@index([worldId, sessionNumber])
  @@map("game_sessions")
}

model GameSessionPageLink {
  id            String   @id @default(cuid())
  gameSessionId String   @map("game_session_id")
  pageId        String   @map("page_id")
  createdAt     DateTime @default(now()) @map("created_at")

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([gameSessionId, pageId])
  @@map("game_session_page_links")
}

model ContentBlock {
  id         String           @id @default(cuid())
  pageId     String           @map("page_id")
  assetId    String?          @map("asset_id")
  type       ContentBlockType
  sortOrder  Int              @map("sort_order")
  content    String           @default("")
  visibility Visibility       @default(dm_only)
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([pageId, sortOrder])
  @@index([assetId])
  @@map("content_blocks")
}

model Asset {
  id          String     @id @default(cuid())
  worldId     String     @map("world_id")
  campaignId  String?    @map("campaign_id")
  title       String
  description String?
  type        AssetType
  storageKey  String     @map("storage_key")
  mimeType    String?    @map("mime_type")
  size        Int        @default(0)
  visibility  Visibility @default(dm_only)
  tags        Json?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  world         World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign      Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pageLinks         AssetPageLink[]
  contentBlocks     ContentBlock[]
  soundboardButtons SoundboardButton[]

  @@index([worldId, type])
  @@map("assets")
}

model AssetPageLink {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  pageId    String   @map("page_id")
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  page  Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([assetId, pageId])
  @@index([pageId])
  @@map("asset_page_links")
}

model PageLink {
  id           String   @id @default(cuid())
  sourcePageId String   @map("source_page_id")
  targetPageId String   @map("target_page_id")
  relationType String   @map("relation_type")
  label        String?
  createdAt    DateTime @default(now()) @map("created_at")

  sourcePage Page @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage Page @relation("TargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@index([sourcePageId])
  @@index([targetPageId])
  @@map("page_links")
}

model LabelTemplate {
  id              String   @id @default(cuid())
  worldId         String?  @map("world_id")
  name            String
  slug            String
  description     String?
  layoutSettings  Json     @map("layout_settings")
  isSystem        Boolean  @default(false) @map("is_system")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  world  World?  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  labels Label[]

  @@unique([worldId, slug])
  @@map("label_templates")
}

model Label {
  id             String          @id @default(cuid())
  worldId        String          @map("world_id")
  campaignId     String?         @map("campaign_id")
  title          String
  sourceType     LabelSourceType @map("source_type")
  sourceId       String?         @map("source_id")
  templateId     String          @map("template_id")
  content        Json
  layoutSettings Json            @map("layout_settings")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  world    World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([worldId, updatedAt])
  @@index([sourceType, sourceId])
  @@map("labels")
}

model SoundboardButton {
  id          String           @id @default(cuid())
  worldId     String           @map("world_id")
  campaignId  String?          @map("campaign_id")
  title       String
  sourceType  SoundSourceType  @map("source_type")
  sourceUrl   String?          @map("source_url")
  assetId     String?          @map("asset_id")
  thumbnail   String?
  volume      Float            @default(1.0)
  loop        Boolean          @default(false)
  tags        Json?
  visibility  Visibility       @default(dm_only)
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  world        World                       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign     Campaign?                   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  asset        Asset?                      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  linkedPages  SoundboardButtonPageLink[]

  @@index([worldId, campaignId])
  @@index([assetId])
  @@map("soundboard_buttons")
}

model SoundboardButtonPageLink {
  id                 String   @id @default(cuid())
  soundboardButtonId String   @map("soundboard_button_id")
  pageId             String   @map("page_id")
  createdAt          DateTime @default(now()) @map("created_at")

  soundboardButton SoundboardButton @relation(fields: [soundboardButtonId], references: [id], onDelete: Cascade)
  page             Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([soundboardButtonId, pageId])
  @@index([pageId])
  @@map("soundboard_button_page_links")
}
