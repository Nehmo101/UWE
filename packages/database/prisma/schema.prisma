// UWE Core data model — structured world knowledge (Source of Truth)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PageType {
  lore
  location
  region
  npc
  faction
  item
  dungeon
  dungeon_level
  room
  encounter
  trap
  puzzle
  loot
  secret
  session
  quest
  handout
  rule
  player_character
  monster
  sound
  map
  note
}

enum DungeonPrepStatus {
  unprepared
  ready
  played
  skipped
}

enum Visibility {
  dm_only
  player_visible
  public
