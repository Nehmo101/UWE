enum TerraKarteStatus {
  /// Der Spieler baut daran. Im Portal sieht sie nur ihr Autor, im Studio
  /// steht sie beim Spielleiter — sichtbar, aber noch nicht abgenommen.
  entwurf
  /// Zur Abnahme eingereicht. Der Autor schreibt nicht mehr; der Spielleiter
  /// gibt frei oder gibt sie mit einer Rueckmeldung zurueck.
  eingereicht
  /// Abgenommen. Ab hier ist die Karte eine Karte der Welt wie jede andere
  /// und fuer alle Weltmitglieder im Portal lesbar.
  freigegeben
}

model TerraKarte {
  id      String @id @default(cuid())
  worldId String @map("world_id")
  titel   String @default("Karte")
  /// Kartenbaum im Terra-Format v5: { format, version, wurzel, karten[] }.
  daten   Json
  /// Konflikterkennung. Die Version reist ueber die postMessage-Bruecke in
  /// beide Richtungen mit; jede erfolgreiche Speicherung erhoeht sie um 1.
  /// Ein Schreiben mit veralteter Version wird abgelehnt statt zu
  /// ueberschreiben — zwei offene Reiter loeschen sich so nicht gegenseitig.
  version Int              @default(1)
  status  TerraKarteStatus @default(freigegeben)
  /// Wer die Karte im Portal angelegt hat. `null` = im Studio entstanden.
  /// Dieses Feld ist der Besitznachweis: der Schreibweg im Portal vergleicht
  /// es im `where`, nicht davor.
  autorUserId String? @map("autor_user_id")
  /// Anzeigename zum Zeitpunkt des Anlegens (Charaktername der Welt, sonst
  /// Anzeigename). Denormalisiert wie bei den Spielerfragen — die Abnahmeliste
  /// im Studio soll ohne Join lesbar sein und einen spaeteren Namenswechsel
  /// nicht rueckwirkend umschreiben.
  autorName            String?   @map("autor_name")
  eingereichtAm        DateTime? @map("eingereicht_am")
  entschiedenAm        DateTime? @map("entschieden_am")
  entschiedenVonUserId String?   @map("entschieden_von_user_id")
  /// Rueckmeldung des Spielleiters beim Zurueckgeben. Der Spieler liest sie
  /// im Portal ueber seinem Entwurf.
  rueckmeldung String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  autor User? @relation("TerraKarteAutor", fields: [autorUserId], references: [id], onDelete: SetNull)

  @@index([worldId])
  @@index([worldId, status])
  @@index([autorUserId])
  @@map("terra_karten")
}

