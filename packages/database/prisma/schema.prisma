// UWE Core data model — structured world knowledge (Source of Truth)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PageType {
  lore
  location
  region
  npc
  faction
  item
  dungeon
  dungeon_level
  room
  encounter
  session
  quest
  handout
  rule
  player_character
  monster
  sound
  map
  note
}

enum Visibility {
  dm_only
  player_visible
  public
  specific_players
  unlock_after_session
  archived
}

enum PublishStatus {
  draft
  internal
  published
  archived
}

enum CanonicalStatus {
  idea
  draft
  canon
  deprecated
  contradictory
  non_canon
}

enum ContentBlockType {
  rich_text
  html
  image
  gallery
  map
  handout
  sound
  relation
  timeline
  statblock
  gm_note
  player_text
  ai_summary
}

enum AssetType {
  image
  map
  handout
  document
  audio
  video
  other
}

enum UserRole {
  owner
  dm
  player
  guest
}

enum WorldMemberRole {
  owner
  dm
  player
}

model User {
  id           String   @id @default(cuid())
  displayName  String   @map("display_name")
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  role         UserRole @default(player)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  worldMemberships WorldMembership[]
  pageAccess       PagePlayerAccess[]
  sessionUnlocks   SessionUnlock[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

model WorldMembership {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  worldId       String          @map("world_id")
  role          WorldMemberRole
  characterName String?         @map("character_name")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
  @@map("world_memberships")
}

model PagePlayerAccess {
  id     String @id @default(cuid())
  pageId String @map("page_id")
  userId String @map("user_id")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("page_player_access")
}

model SessionUnlock {
  id           String   @id @default(cuid())
  pageId       String   @map("page_id")
  userId       String   @map("user_id")
  unlockedAt   DateTime @default(now()) @map("unlocked_at")
  sessionLabel String?  @map("session_label")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("session_unlocks")
}

model World {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  guestModeEnabled Boolean  @default(false) @map("guest_mode_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  campaigns        Campaign[]
  pages            Page[]
  assets           Asset[]
  worldMemberships WorldMembership[]

  @@map("worlds")
}

model Campaign {
  id          String   @id @default(cuid())
  worldId     String   @map("world_id")
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  world  World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  pages  Page[]
  assets Asset[]

  @@unique([worldId, slug])
  @@map("campaigns")
}

model Page {
  id              String          @id @default(cuid())
  worldId         String          @map("world_id")
  campaignId      String?         @map("campaign_id")
  title           String
  slug            String
  type            PageType
  summary         String?
  visibility      Visibility      @default(dm_only)
  publishStatus   PublishStatus   @default(draft) @map("publish_status")
  canonicalStatus CanonicalStatus @default(draft) @map("canonical_status")
  tags            Json?
  aliases         Json?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  world            World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentBlocks    ContentBlock[]
  outgoingLinks    PageLink[]         @relation("SourcePage")
  incomingLinks    PageLink[]         @relation("TargetPage")
  playerAccess     PagePlayerAccess[]
  sessionUnlocks   SessionUnlock[]
  assetLinks       AssetPageLink[]

  @@unique([worldId, slug])
  @@map("pages")
}

model ContentBlock {
  id         String           @id @default(cuid())
  pageId     String           @map("page_id")
  assetId    String?          @map("asset_id")
  type       ContentBlockType
  sortOrder  Int              @map("sort_order")
  content    String           @default("")
  visibility Visibility       @default(dm_only)
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([pageId, sortOrder])
  @@index([assetId])
  @@map("content_blocks")
}

model Asset {
  id          String     @id @default(cuid())
  worldId     String     @map("world_id")
  campaignId  String?    @map("campaign_id")
  title       String
  description String?
  type        AssetType
  storageKey  String     @map("storage_key")
  mimeType    String?    @map("mime_type")
  size        Int        @default(0)
  visibility  Visibility @default(dm_only)
  tags        Json?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  world         World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign      Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pageLinks     AssetPageLink[]
  contentBlocks ContentBlock[]

  @@index([worldId, type])
  @@map("assets")
}

model AssetPageLink {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  pageId    String   @map("page_id")
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  page  Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([assetId, pageId])
  @@index([pageId])
  @@map("asset_page_links")
}

model PageLink {
  id           String   @id @default(cuid())
  sourcePageId String   @map("source_page_id")
  targetPageId String   @map("target_page_id")
  relationType String   @map("relation_type")
  label        String?
  createdAt    DateTime @default(now()) @map("created_at")

  sourcePage Page @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage Page @relation("TargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@index([sourcePageId])
  @@index([targetPageId])
  @@map("page_links")
}
