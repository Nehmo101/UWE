model User {
  id                  String     @id @default(cuid())
  displayName         String     @map("display_name")
  email               String?    @unique
  passwordHash        String?    @map("password_hash")
  isOwner             Boolean    @default(false) @map("is_owner")
  portalAccess        Boolean    @default(false) @map("portal_access")
  studioAccess        Boolean    @default(false) @map("studio_access")
  brainAccess         Boolean    @default(false) @map("brain_access")
  familyAccess        Boolean    @default(false) @map("family_access")
  /// Darf die Maschinenraum-KI benutzen (G-KI). KEIN fuenftes App-Haekchen: die vier
  /// oben sagen, welche App diese Adresse betreten darf, dieses Feld sagt, ob
  /// sie darin die lokale Inferenz ausloesen darf. Der Owner braucht es nicht
  /// — `isOwner` geht immer vor.
  aiAccess            Boolean    @default(false) @map("ai_access")
  status              UserStatus @default(active)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  /// Fehlgeschlagene Login-Versuche seit dem letzten Erfolg. Kontobasiert (nicht
  /// IP-gekeyt), damit ein Angreifer die Sperre nicht durch IP-Rotation umgeht.
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  /// Gesetzt, solange das Konto nach zu vielen Fehlversuchen gesperrt ist.
  lockedUntil         DateTime?  @map("locked_until")
  forcePasswordChange Boolean    @default(false) @map("force_password_change")
  resetTokenHash      String?    @map("reset_token_hash")
  resetTokenExpiresAt DateTime?  @map("reset_token_expires_at")
  inviteTokenHash     String?    @map("invite_token_hash")
  inviteTokenExpiresAt DateTime? @map("invite_token_expires_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  sessions            Session[]
  worldMemberships    WorldMembership[]
  playerQuestFlags      PlayerQuestFlag[]
  sessionAvailabilities SessionAvailability[]
  playerNotes         PlayerNote[]
  aiRuns              AiRun[]
  jobs                Job[]
  apiTokens           ApiToken[]
  twoFactorSecret     TwoFactorSecret?
  twoFactorChallenges TwoFactorChallenge[]
  authIdentities      AuthIdentity[]
  webAuthnCredentials WebAuthnCredential[]
  aiUsageLogs          AiUsageLog[]
  dashboardLayouts       DashboardLayout[]
  ownedCharacters        Character[]
  bugReports             BugReport[]
  importJobs             ImportJob[]
  terraKarten            TerraKarte[]          @relation("TerraKarteAutor")

  @@map("users")
}

model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  pageKey   String   @map("page_key")
  widgets   String
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
  @@index([userId])
  @@map("dashboard_layouts")
}

model AuthIdentity {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  /// Provider-reported e-mail at link time — diagnostics only. The identity
  /// binds to `providerUserId` (e.g. the Google `sub`), never to the e-mail.
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("auth_identities")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("sessions")
}

model WorldMembership {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  worldId       String          @map("world_id")
  characterName String?         @map("character_name")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
  @@map("world_memberships")
}

model PlayerQuestFlag {
  id        String   @id @default(cuid())
  pageId    String   @map("page_id")
  userId    String   @map("user_id")
  priority  String   @default("normal")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("player_quest_flags")
}

model SessionAvailability {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  status    String   @default("maybe")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("session_availabilities")
}

model World {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  isSandbox            Boolean  @default(false) @map("is_sandbox")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  campaigns        Campaign[]
  pages            Page[]
  assets           Asset[]
  assetAlbums      AssetAlbum[]
  worldMemberships WorldMembership[]
  gameSessions     GameSession[]
  labelTemplates    LabelTemplate[]
  labels            Label[]
  printLists        PrintList[]
  soundboardButtons SoundboardButton[]
  playerNotes       PlayerNote[]
  spotifyConnection SpotifyConnection?
  brainDocuments    BrainDocument[]
  brainFacts        BrainFact[]
  brainLinks        BrainLink[]
  aiRuns            AiRun[]
  generatorPresets    GeneratorPreset[]
  generatorOutputs    GeneratorOutput[]
  imageStudioProjects ImageStudioProject[]
  dndBeyondReferences DndBeyondReference[]
  terraKarten         TerraKarte[]
  worldCalendar       WorldCalendar?
  worldEvents         WorldEvent[]
  factionStates       FactionState[]
  characters          Character[]
  partyTreasury       PartyTreasury?
  inventoryItems      InventoryItem[]
  structuredStatblocks StructuredStatblock[]
  structuredItems      StructuredItem[]
  playerQuestions      PlayerQuestion[]
  importJobs           ImportJob[]
  rollTables           RollTable[]

  @@map("worlds")
}

model Campaign {
  id          String   @id @default(cuid())
  worldId     String   @map("world_id")
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  world        World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  pages             Page[]
  assets            Asset[]
  gameSessions      GameSession[]
  labels            Label[]
  printLists        PrintList[]
  soundboardButtons SoundboardButton[]
  playerNotes       PlayerNote[]
  brainDocuments    BrainDocument[]
  brainFacts        BrainFact[]
  characters        Character[]

  @@unique([worldId, slug])
  @@map("campaigns")
}

model Page {
  id              String             @id @default(cuid())
  worldId         String             @map("world_id")
  campaignId      String?            @map("campaign_id")
  parentPageId    String?            @map("parent_page_id")
  sortIndex       Int?               @map("sort_index")
  title           String
  slug            String
  type            PageType
  summary         String?
  canonicalStatus CanonicalStatus    @default(draft) @map("canonical_status")
  /// Freigegeben fuer das Portal.
  ///
  /// Die Welt-Zuordnung sagt, WELCHE Welt jemand sieht; dieses Haekchen sagt,
  /// welche Seiten daraus im Spieler-Wiki auftauchen. Beides zusammen ersetzt
  /// nicht den `:::dm`-Bereich: der schneidet Zeilen aus einer sichtbaren Seite,
  /// dieses Feld entscheidet ueber die Seite als Ganzes — samt Titel, und damit
  /// auch in Suche, Baum und Inhaltsverzeichnis.
  ///
  /// Vorgabe `false`, weil das die fail-closed Richtung ist: Eine neu angelegte
  /// oder frisch importierte Seite ist erst einmal DM-Material, bis jemand sie
  /// ausdruecklich freigibt. Das Studio-Haekchen geht immer vor.
  portalReleased  Boolean            @default(false) @map("portal_released")
  prepStatus      DungeonPrepStatus? @map("prep_status")
  questStatus     QuestLifecycleStatus? @map("quest_status")
  tags            Json?
  aliases         Json?
  aiReviewedAt    DateTime?          @map("ai_reviewed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  world            World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  parentPage       Page?              @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages       Page[]             @relation("PageHierarchy")
  contentBlocks    ContentBlock[]
  outgoingLinks    PageLink[]         @relation("SourcePage")
  incomingLinks    PageLink[]         @relation("TargetPage")
  playerQuestFlags    PlayerQuestFlag[]
  gameSessionLinks       GameSessionPageLink[]
  soundboardButtonLinks  SoundboardButtonPageLink[]
  assetPageLinks         AssetPageLink[]
  playerNotes            PlayerNote[]
  brainDocuments         BrainDocument[]
  brainFacts             BrainFact[]
  aiRuns                 AiRun[]
  generatorOutputs       GeneratorOutput[]
  dndBeyondReferences    DndBeyondReference[]
  versions               PageVersion[]
  worldEventLinks        WorldEventEntityLink[]
  factionState           FactionState?
  character              Character?
  inventoryItems         InventoryItem[]
  structuredStatblock    StructuredStatblock?
  structuredItem         StructuredItem?

  @@unique([worldId, slug])
  @@index([parentPageId])
  @@index([parentPageId, sortIndex])
  @@map("pages")
}

model WorldCalendar {
  id           String   @id @default(cuid())
  worldId      String   @unique @map("world_id")
  name         String   @default("Weltkalender")
  months       Json
  daysPerWeek  Int      @default(7) @map("days_per_week")
  dayNames     Json?    @map("day_names")
  currentDate  Json     @map("current_date")
  epochLabel   String?  @map("epoch_label")
  settings     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  world  World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  events WorldEvent[]

  @@map("world_calendars")
}

model WorldEvent {
  id                 String               @id @default(cuid())
  worldId            String               @map("world_id")
  calendarId         String?              @map("calendar_id")
  inGameDate         Json                 @map("in_game_date")
  title              String
  summaryPlayer      String?              @map("summary_player")
  summaryDm          String?              @map("summary_dm")
  sourceType         WorldEventSourceType @default(manual) @map("source_type")
  sourceAiProposalId String?              @map("source_ai_proposal_id")
  gameSessionId      String?              @map("game_session_id")
  sortOrder          Int                  @default(0) @map("sort_order")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  world       World                  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  calendar    WorldCalendar?         @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  gameSession GameSession?           @relation(fields: [gameSessionId], references: [id], onDelete: SetNull)
  entityLinks WorldEventEntityLink[]

  @@index([worldId, sortOrder])
  @@map("world_events")
}

model WorldEventEntityLink {
  id        String               @id @default(cuid())
  eventId   String               @map("event_id")
  pageId    String               @map("page_id")
  role      WorldEventEntityRole @default(involved)
  createdAt DateTime             @default(now()) @map("created_at")

  event WorldEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  page  Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([eventId, pageId, role])
  @@index([pageId])
  @@map("world_event_entity_links")
}

model FactionState {
  id            String   @id @default(cuid())
  worldId       String   @map("world_id")
  pageId        String   @unique @map("page_id")
  goals         Json?
  resources     Json?
  relationships Json?
  agenda        String   @default("")
  powerLevel    Int?     @map("power_level")
  notes         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  page  Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([worldId])
  @@map("faction_states")
}

model Character {
  id           String          @id @default(cuid())
  worldId      String          @map("world_id")
  pageId       String?         @unique @map("page_id")
  ownerUserId  String          @map("owner_user_id")
  campaignId   String?         @map("campaign_id")
  displayName  String          @map("display_name")
  rulesEdition DndRulesEdition @default(dnd5e_2024) @map("rules_edition")
  level        Int             @default(1)
  abilities    Json
  skills       Json?
  combat       Json?
  spellcasting Json?
  classes      Json?
  species      Json?
  background   Json?
  features     Json?
  bio          Json?
  notes        String          @default("")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  world          World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  page           Page?            @relation(fields: [pageId], references: [id], onDelete: SetNull)
  owner          User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  spells         CharacterSpell[]
  inventoryItems InventoryItem[]

  @@index([worldId, ownerUserId])
  @@map("characters")
}

model CharacterSpell {
