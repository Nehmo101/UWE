  asset
}

model User {
  id           String   @id @default(cuid())
  displayName  String   @map("display_name")
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  role         UserRole @default(player)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  worldMemberships WorldMembership[]
  pageAccess       PagePlayerAccess[]
  sessionUnlocks   SessionUnlock[]
  playerNotes      PlayerNote[]
  aiRuns           AiRun[]
  mailRecipients   MailRecipient[]
  jobs             Job[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

model WorldMembership {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  worldId       String          @map("world_id")
  role          WorldMemberRole
  characterName String?         @map("character_name")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
  @@map("world_memberships")
}

model PagePlayerAccess {
  id     String @id @default(cuid())
  pageId String @map("page_id")
  userId String @map("user_id")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("page_player_access")
}

model SessionUnlock {
  id           String   @id @default(cuid())
  pageId       String   @map("page_id")
  userId       String   @map("user_id")
  unlockedAt   DateTime @default(now()) @map("unlocked_at")
  sessionLabel String?  @map("session_label")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("session_unlocks")
}

model World {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  guestModeEnabled     Boolean  @default(false) @map("guest_mode_enabled")
  guestCommentsEnabled Boolean  @default(false) @map("guest_comments_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  campaigns        Campaign[]
  pages            Page[]
  assets           Asset[]
  worldMemberships WorldMembership[]
  gameSessions     GameSession[]
  labelTemplates    LabelTemplate[]
  labels            Label[]
  printLists        PrintList[]
  soundboardButtons SoundboardButton[]
  playerNotes       PlayerNote[]
  shareLinks        ShareLink[]
  spotifyConnection SpotifyConnection?
  brainDocuments    BrainDocument[]
  brainFacts        BrainFact[]
  brainLinks        BrainLink[]
  aiRuns            AiRun[]
  mailTemplates       MailTemplate[]
  mailRecipientGroups MailRecipientGroup[]
  mailMessageLogs     MailMessageLog[]
  captureEntries      CaptureEntry[]
  personalProjects    PersonalProject[]
  workshopProjects    WorkshopProject[]
  generatorPresets    GeneratorPreset[]
  generatorOutputs    GeneratorOutput[]
  imageStudioProjects ImageStudioProject[]
  calendarEvents      CalendarEvent[]
  dndBeyondReferences DndBeyondReference[]

  @@map("worlds")
}

model Campaign {
  id          String   @id @default(cuid())
  worldId     String   @map("world_id")
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  world        World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  pages             Page[]
  assets            Asset[]
  gameSessions      GameSession[]
  labels            Label[]
  printLists        PrintList[]
  soundboardButtons SoundboardButton[]
  playerNotes       PlayerNote[]
  brainDocuments    BrainDocument[]
  brainFacts        BrainFact[]

  @@unique([worldId, slug])
  @@map("campaigns")
}

model Page {
  id              String             @id @default(cuid())
  worldId         String             @map("world_id")
  campaignId      String?            @map("campaign_id")
  parentPageId    String?            @map("parent_page_id")
  title           String
  slug            String
  type            PageType
  summary         String?
  visibility      Visibility         @default(dm_only)
  publishStatus   PublishStatus      @default(draft) @map("publish_status")
  canonicalStatus CanonicalStatus    @default(draft) @map("canonical_status")
  prepStatus      DungeonPrepStatus? @map("prep_status")
  tags            Json?
  aliases         Json?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  world            World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  parentPage       Page?              @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages       Page[]             @relation("PageHierarchy")
  contentBlocks    ContentBlock[]
  outgoingLinks    PageLink[]         @relation("SourcePage")
  incomingLinks    PageLink[]         @relation("TargetPage")
  playerAccess       PagePlayerAccess[]
  sessionUnlocks     SessionUnlock[]
  gameSessionLinks       GameSessionPageLink[]
  soundboardButtonLinks  SoundboardButtonPageLink[]
  assetPageLinks         AssetPageLink[]
  playerNotes            PlayerNote[]
  brainDocuments         BrainDocument[]
  brainFacts             BrainFact[]
  aiRuns                 AiRun[]
  captureEntries         CaptureEntry[]
  personalProjects       PersonalProject[]
  workshopProjects       WorkshopProject[]
  generatorOutputs       GeneratorOutput[]
  dndBeyondReferences    DndBeyondReference[]

  @@unique([worldId, slug])
  @@index([parentPageId])
  @@map("pages")
}

model GameSession {
  id              String            @id @default(cuid())
  worldId         String            @map("world_id")
  campaignId      String?           @map("campaign_id")
  title           String
  sessionNumber   Int               @map("session_number")
  date            DateTime?         @map("date")
  status          GameSessionStatus @default(planned)
  summaryDm       String?           @map("summary_dm")
  summaryPlayer   String?           @map("summary_player")
  notes           String?
  openPlots       String?           @map("open_plots")
  playerDecisions String?           @map("player_decisions")
  recapPublished  Boolean           @default(false) @map("recap_published")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  world        World                 @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign     Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  linkedPages  GameSessionPageLink[]
  playerNotes  PlayerNote[]
  brainDocuments BrainDocument[]
  brainFacts     BrainFact[]
  aiRuns         AiRun[]
  calendarEvents CalendarEvent[]

  @@index([worldId, sessionNumber])
  @@map("game_sessions")
}

model GameSessionPageLink {
  id            String   @id @default(cuid())
  gameSessionId String   @map("game_session_id")
  pageId        String   @map("page_id")
  createdAt     DateTime @default(now()) @map("created_at")

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([gameSessionId, pageId])
  @@map("game_session_page_links")
}

model ContentBlock {
  id         String           @id @default(cuid())
  pageId     String           @map("page_id")
  assetId    String?          @map("asset_id")
  type       ContentBlockType
  sortOrder  Int              @map("sort_order")
  content    String           @default("")
  visibility Visibility       @default(dm_only)
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([pageId, sortOrder])
  @@index([assetId])
  @@map("content_blocks")
}

model Asset {
  id          String     @id @default(cuid())
  worldId     String     @map("world_id")
  campaignId  String?    @map("campaign_id")
  title       String
  description String?
  type        AssetType
  storageKey  String     @map("storage_key")
  mimeType    String?    @map("mime_type")
  size        Int        @default(0)
  visibility  Visibility @default(dm_only)
  tags        Json?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  world         World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign      Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pageLinks         AssetPageLink[]
  contentBlocks     ContentBlock[]
  soundboardButtons SoundboardButton[]
  imageStudioVersions ImageStudioVersion[]

  @@index([worldId, type])
  @@map("assets")
}

model AssetPageLink {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  pageId    String   @map("page_id")
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  page  Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([assetId, pageId])
  @@index([pageId])
  @@map("asset_page_links")
}

model PageLink {
  id           String   @id @default(cuid())
  sourcePageId String   @map("source_page_id")
  targetPageId String   @map("target_page_id")
  relationType String   @map("relation_type")
  label        String?
  createdAt    DateTime @default(now()) @map("created_at")

  sourcePage Page @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage Page @relation("TargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@index([sourcePageId])
  @@index([targetPageId])
  @@map("page_links")
}

model LabelTemplate {
  id              String   @id @default(cuid())
  worldId         String?  @map("world_id")
  name            String
  slug            String
  description     String?
  layoutSettings  Json     @map("layout_settings")
  isSystem        Boolean  @default(false) @map("is_system")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  world  World?  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  labels Label[]

  @@unique([worldId, slug])
  @@map("label_templates")
}

model Label {
  id             String           @id @default(cuid())
  worldId        String           @map("world_id")
  campaignId     String?          @map("campaign_id")
  title          String
  sourceType     LabelSourceType  @map("source_type")
  sourceId       String?          @map("source_id")
  templateId     String           @map("template_id")
  content        Json
  layoutSettings Json             @map("layout_settings")
  printStatus    LabelPrintStatus @default(open) @map("print_status")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  world          World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template       LabelTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  printListItems PrintListItem[]

  @@index([worldId, updatedAt])
  @@index([sourceType, sourceId])
  @@map("labels")
}

model PrintList {
  id             String           @id @default(cuid())
  worldId        String           @map("world_id")
  campaignId     String?          @map("campaign_id")
  name           String
  description    String?
  status         LabelPrintStatus @default(open)
  forNextSession Boolean          @default(false) @map("for_next_session")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  world    World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  items    PrintListItem[]

  @@index([worldId, updatedAt])
  @@map("print_lists")
}

model PrintListItem {
  id          String @id @default(cuid())
  printListId String @map("print_list_id")
  labelId     String @map("label_id")
  copies      Int    @default(1)
  sortOrder   Int    @default(0) @map("sort_order")

  printList PrintList @relation(fields: [printListId], references: [id], onDelete: Cascade)
  label     Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([printListId, labelId])
  @@index([printListId, sortOrder])
  @@map("print_list_items")
}

model SoundboardButton {
  id          String           @id @default(cuid())
  worldId     String           @map("world_id")
  campaignId  String?          @map("campaign_id")
  title       String
  sourceType  SoundSourceType  @map("source_type")
  sourceUrl   String?          @map("source_url")
  assetId     String?          @map("asset_id")
  thumbnail   String?
  volume      Float            @default(1.0)
  loop        Boolean          @default(false)
  tags        Json?
  visibility  Visibility       @default(dm_only)
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  world        World                       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign     Campaign?                   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  asset        Asset?                      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  linkedPages  SoundboardButtonPageLink[]

  @@index([worldId, campaignId])
  @@index([assetId])
  @@map("soundboard_buttons")
}

model SoundboardButtonPageLink {
  id                 String   @id @default(cuid())
  soundboardButtonId String   @map("soundboard_button_id")
  pageId             String   @map("page_id")
  createdAt          DateTime @default(now()) @map("created_at")

  soundboardButton SoundboardButton @relation(fields: [soundboardButtonId], references: [id], onDelete: Cascade)
  page             Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([soundboardButtonId, pageId])
  @@index([pageId])
  @@map("soundboard_button_page_links")
}

model PlayerNote {
  id            String               @id @default(cuid())
  worldId       String               @map("world_id")
  campaignId    String               @map("campaign_id")
  pageId        String?              @map("page_id")
  gameSessionId String?              @map("game_session_id")
  userId        String               @map("user_id")
  content       String
  visibility    PlayerNoteVisibility @default(private)
  status        PlayerNoteStatus     @default(draft)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  world       World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  page        Page?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  gameSession GameSession? @relation(fields: [gameSessionId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([worldId, status])
  @@index([worldId, campaignId])
  @@index([userId, worldId])
  @@index([pageId])
  @@index([gameSessionId])
  @@map("player_notes")
}

model ShareLink {
  id           String          @id @default(cuid())
  worldId      String          @map("world_id")
  targetType   ShareTargetType @map("target_type")
  targetId     String          @map("target_id")
  token        String          @unique
  expiresAt    DateTime?       @map("expires_at")
  passwordHash String?         @map("password_hash")
  readOnly     Boolean         @default(true) @map("read_only")
  logAccess    Boolean         @default(false) @map("log_access")
  enabled      Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  world      World             @relation(fields: [worldId], references: [id], onDelete: Cascade)
  accessLogs ShareAccessLog[]

  @@index([worldId])
  @@index([targetType, targetId])
  @@map("share_links")
}

model ShareAccessLog {
  id          String   @id @default(cuid())
  shareLinkId String   @map("share_link_id")
  accessedAt  DateTime @default(now()) @map("accessed_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId, accessedAt])
  @@map("share_access_logs")
}

model SpotifyConnection {
  id                    String   @id @default(cuid())
  worldId               String   @unique @map("world_id")
  spotifyUserId         String   @map("spotify_user_id")
  spotifyDisplayName    String?  @map("spotify_display_name")
  accessTokenEncrypted  String   @map("access_token_encrypted")
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  expiresAt             DateTime @map("expires_at")
  scopes                String   @default("")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@map("spotify_connections")
}

model SystemSettings {
  id        String   @id @default("default")
  settings  Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum ActivityAction {
  content_created
  content_updated
  content_deleted
  content_restored
  visibility_changed
  inspector_fix_applied
  template_created
  template_updated
  template_used
  import_executed
  export_executed
  backup_created
  backup_restored
  seed_applied
  ai_proposal_applied
  ai_proposal_discarded
  error
  warning
}

enum ActivityTargetType {
  page
  content_block
  asset
  page_template
  world
  share_link
  game_session
  label
  print_list
  ai_proposal
  ai_run
  brain_document
  system
}

// Audit log. Intentionally without foreign keys to content tables so entries
// survive the deletion of the objects they describe.
model ActivityLog {
  id          String             @id @default(cuid())
  worldId     String?            @map("world_id")
  worldSlug   String?            @map("world_slug")
  action      ActivityAction
  targetType  ActivityTargetType @map("target_type")
  targetId    String?            @map("target_id")
  targetLabel String?            @map("target_label")
  targetHref  String?            @map("target_href")
  summary     String
  details     Json?
  undoEntryId String?            @map("undo_entry_id")
  createdAt   DateTime           @default(now()) @map("created_at")

  undoEntry UndoEntry? @relation(fields: [undoEntryId], references: [id], onDelete: SetNull)

  @@index([worldId, createdAt])
  @@index([createdAt])
  @@index([undoEntryId])
  @@map("activity_logs")
}

// Undo basis: a JSON snapshot of the state *before* a destructive or
// automatic change (inspector fixes, deletions). Restoring re-applies the
// snapshot; `undoneAt` marks consumed entries.
model UndoEntry {
  id         String             @id @default(cuid())
  worldId    String?            @map("world_id")
  operation  String
  targetType ActivityTargetType @map("target_type")
  targetId   String             @map("target_id")
  snapshot   Json
  undoneAt   DateTime?          @map("undone_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  activityLogs ActivityLog[]
  applyLogs    AiApplyLog[]

  @@index([worldId, createdAt])
  @@map("undo_entries")
}

// User-editable Quick-Create page templates. System templates are seeded
// from the previous code-defined set (see seed-page-templates.ts) and can be
// deactivated but not deleted.
model PageTemplate {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  description       String     @default("")
  pageType          PageType   @map("page_type")
  defaultVisibility Visibility @default(dm_only) @map("default_visibility")
  titlePlaceholder  String     @default("") @map("title_placeholder")
  blocks            Json
  isSystem          Boolean    @default(false) @map("is_system")
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("page_templates")
}

// Tracks which data seeds (e.g. system page templates) have already been
// applied, so seeds stay idempotent across restarts and upgrades.
model SeedHistory {
  id        String   @id @default(cuid())
  key       String   @unique
  version   Int      @default(1)
  appliedAt DateTime @default(now()) @map("applied_at")
  details   Json?

  @@map("seed_history")
}

// AI Run History — every KI execution is stored for review; results never auto-apply.
model AiRun {
  id            String      @id @default(cuid())
  worldId       String?     @map("world_id")
  pageId        String?     @map("page_id")
  gameSessionId String?     @map("game_session_id")
  userId        String?     @map("user_id")
  source        String?
  taskType      String      @map("task_type")
  provider      String
  model         String
  status        AiRunStatus @default(pending)
  systemPrompt  String?     @map("system_prompt")
  userPrompt    String?     @map("user_prompt")
  contextData   Json?       @map("context_data")
  resultText    String?     @map("result_text")
  resultMeta    Json?       @map("result_meta")
  errorMessage  String?     @map("error_message")
  errorDetails  Json?       @map("error_details")
  durationMs    Int?        @map("duration_ms")
  targetType    String?     @map("target_type")
  targetId      String?     @map("target_id")
  proposals     Json?
  appliedAt     DateTime?   @map("applied_at")
  discardedAt   DateTime?   @map("discarded_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  world       World?       @relation(fields: [worldId], references: [id], onDelete: SetNull)
  page        Page?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  gameSession GameSession? @relation(fields: [gameSessionId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiProposals AiProposal[]

  @@index([worldId, createdAt])
  @@index([status, createdAt])
  @@index([pageId])
  @@map("ai_runs")
}

// Generated patch / proposal from a completed AI run. Never auto-applies to production data.
model AiProposal {
  id                String              @id @default(cuid())
  aiRunId           String              @map("ai_run_id")
  worldId           String              @map("world_id")
  status            AiProposalStatus    @default(pending)
  suggestedMode     AiProposalApplyMode @map("suggested_mode")
  patch             Json
  resultText        String              @map("result_text")
  editedText        String?             @map("edited_text")
  sourcePageId      String?             @map("source_page_id")
  sessionId         String?             @map("session_id")
  appliedTargetType ActivityTargetType? @map("applied_target_type")
  appliedTargetId   String?             @map("applied_target_id")
  appliedAt         DateTime?           @map("applied_at")
  discardedAt       DateTime?           @map("discarded_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  aiRun     AiRun        @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  applyLogs AiApplyLog[]

  @@index([aiRunId])
  @@index([worldId, status])
  @@map("ai_proposals")
}

// Audit log for explicit apply/discard/rerun actions on AI proposals.
model AiApplyLog {
  id          String        @id @default(cuid())
  proposalId  String        @map("proposal_id")
  aiRunId     String        @map("ai_run_id")
